<nav class="navbar">
  <div class="nav-container" style="flex-direction: column; align-items: stretch; gap: 0.75rem;">
    <!-- Top Row: Brand, Mobile Toggle, User Badge & Logout -->
    <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
      <button class="mobile-toggle" id="mobileToggle" aria-label="Menú">&#9776;</button>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <% if (user) { %>
          <span class="user-pill">
            <small style="color: var(--gold-primary); font-weight: 800;"><%= user.role.toUpperCase() %>:</small> <%= user.full_name %>
          </span>
          <a href="/auth/logout" class="btn btn-outline-gold btn-sm">Cerrar Sesión</a>
        <% } else { %>
          <ul class="nav-links" id="navLinks" style="margin: 0;">
            <li><a href="/" class="nav-link">Inicio</a></li>
            <li><a href="/torneos" class="nav-link">Torneos</a></li>
            <li><a href="/auth/login" class="nav-link" style="border-bottom-color: transparent;">Iniciar Sesión</a></li>
            <li><a href="/auth/registro" class="btn btn-gold btn-sm">📝 Registrarse</a></li>
          </ul>
        <% } %>
      </div>
    </div>

    <!-- Logged-in Banner: Golden Modules Box for each user role -->
    <% if (user) { %>
      <div class="role-subnav-box" style="margin-bottom: 0.25rem;">
        <% if (user.role === 'admin') { %>
          <a href="/admin/dashboard" class="role-subnav-btn">📊 Status</a>
          <a href="/admin/alumnos" class="role-subnav-btn">👥 Patinadoras</a>
          <a href="/admin/cms" class="role-subnav-btn">🖥️ Página Principal</a>
          <a href="/admin/inscripciones" class="role-subnav-btn">📜 Inscripciones y Pagos</a>
          <a href="/admin/finanzas" class="role-subnav-btn">💰 Gastos y Presupuesto</a>
          <a href="/admin/posiciones" class="role-subnav-btn">🥇 Puntajes de Clubes</a>
          <a href="/admin/torneos" class="role-subnav-btn">🏆 Torneos y Categorías</a>
          <a href="/admin/clubes" class="role-subnav-btn">🏛️ Clubes</a>
          <a href="/admin/usuarios" class="role-subnav-btn">👥 Usuarios (Profes/Jueces)</a>
        <% } else if (user.role === 'profesor') { %>
          <a href="/profesor/dashboard" class="role-subnav-btn">👩‍🎓 Mis Alumnas</a>
        <% } else if (user.role === 'juez') { %>
          <a href="/juez/planilla" class="role-subnav-btn">📋 Planilla de Juzgamiento</a>
          <a href="/admin/posiciones" class="role-subnav-btn">🥇 Puntajes de Clubes</a>
        <% } %>
      </div>
    <% } %>
  </div>
</nav>
