<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="brand">
      <img src="/img/logo.svg" alt="Star Dance Logo">
      <span>STAR DANCE</span>
    </a>
    
    <button class="mobile-toggle" id="mobileToggle" aria-label="Menú">&#9776;</button>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class="nav-link">Inicio</a></li>
      <li><a href="/torneos" class="nav-link">Torneos</a></li>
      <li><a href="/jueces" class="nav-link">Jueces</a></li>
      
      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <li><a href="/admin/dashboard" class="nav-link">Panel Admin</a></li>
        <% } else if (user.role === 'profesor') { %>
          <li><a href="/profesor/dashboard" class="nav-link">Mis Alumnos</a></li>
        <% } else if (user.role === 'juez') { %>
          <li><a href="/juez/planilla" class="nav-link">Planilla Juez</a></li>
        <% } %>

        <li>
          <span class="user-pill">
            <small><%= user.role.toUpperCase() %>:</small> <%= user.full_name %>
          </span>
        </li>
        <li>
          <a href="/auth/logout" class="btn btn-outline-gold btn-sm">Salir</a>
        </li>
      <% } else { %>
        <li>
          <a href="/auth/login" class="btn btn-gold btn-sm">Ingreso Profesores/Jueces</a>
        </li>
      <% } %>
    </ul>
  </div>
</nav>
