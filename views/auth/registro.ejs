<%- include('../partials/header', { title: 'Crear Cuenta' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 480px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo-emblem.png" alt="Star Dance" style="width: 84px; height: 84px; margin-bottom: 0.5rem; border-radius: 50%; filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.4));">
      <h1 style="color: var(--gold-light); font-size: 1.6rem;">Crear Cuenta</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Registrate para cargar e inscribir tus patinadoras. Tu cuenta queda activa de inmediato.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-auto-dismiss">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        ✅ <%= success %>
      </div>
      <div style="text-align: center; margin-top: 1rem;">
        <a href="/auth/login" class="btn btn-gold" style="width: 100%;">🔐 Ir al Ingreso</a>
      </div>
    <% } else { %>
      <form action="/auth/registro" method="POST">
        <div class="form-group">
          <label class="form-label" for="full_name">Nombre Completo *</label>
          <input type="text" id="full_name" name="full_name" class="form-control" placeholder="EJ: ANA MARTÍNEZ" required style="text-transform: uppercase;" value="<%= typeof form !== 'undefined' && form ? form.full_name || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Correo Electrónico *</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="ana@escuelapatin.com" required value="<%= typeof form !== 'undefined' && form ? form.email || '' : '' %>">
          <small style="color: var(--text-muted);">Con este correo vas a ingresar a la plataforma.</small>
        </div>

        <div class="form-group">
          <label class="form-label" for="phone">Teléfono</label>
          <input type="text" id="phone" name="phone" class="form-control" placeholder="+54 9 264 ..." value="<%= typeof form !== 'undefined' && form ? form.phone || '' : '' %>">
        </div>

      <h3 style="color: var(--gold-light); margin: 1.25rem 0 0.5rem; font-size: 1.05rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;">
        🏛️ Club / Escuela
      </h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem;">
          El club que crees queda vinculado a tu cuenta. Después podés crear más desde tu panel.
        </p>

        <div class="form-group">
          <label class="form-label" for="club_name">Nombre del Club / Escuela *</label>
          <input type="text" id="club_name" name="club_name" class="form-control" placeholder="EJ: CLUB DEPORTIVO ESTRELLA" style="text-transform: uppercase;" value="<%= typeof form !== 'undefined' && form && form.club_name ? form.club_name : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="club_city">Barrio / Localidad</label>
          <input type="text" id="club_city" name="club_city" class="form-control" placeholder="EJ: VILLA CAROLINA" style="text-transform: uppercase;" value="<%= typeof form !== 'undefined' && form && form.club_city ? form.club_city : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Contraseña * <small style="color: var(--text-muted);">(mín. 6 caracteres)</small></label>
          <div style="position: relative;">
            <input type="password" id="password" name="password" class="form-control" placeholder="Tu contraseña" required minlength="6" style="padding-right: 2.75rem;">
            <button type="button" id="togglePassword" class="btn btn-secondary btn-sm" style="position: absolute; right: 0.35rem; top: 50%; transform: translateY(-50%);" aria-label="Mostrar/ocultar contraseña">👁</button>
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%;">
          📝 Crear Cuenta
        </button>
      </form>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(212,175,55,0.2); font-size: 0.85rem; color: var(--text-muted); text-align: center;">
        <p>¿Ya tenés una cuenta? <a href="/auth/login" style="color: var(--gold-light);">Ingresá aquí &rarr;</a></p>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('togglePassword');
    const input = document.getElementById('password');
    if (btn && input) {
      btn.addEventListener('click', () => {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.textContent = show ? '🙈' : '👁';
      });
    }
  });
</script>

<%- include('../partials/footer') %>
