<%- include('../partials/header', { title: 'Crear Cuenta' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 480px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem; filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.4));">
      <h1 style="color: var(--gold-light); font-size: 1.6rem;">Crear Cuenta</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Registrate para cargar e inscribir tus patinadoras. Necesitás verificar tu email para ingresar.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-auto-dismiss">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        ✅ <%= success %>
      </div>
      <% if (typeof verificationLink !== 'undefined' && verificationLink) { %>
        <div class="alert alert-warning" style="word-break: break-all;">
          <strong>🔗 Enlace de verificación (válido 24 hs):</strong><br>
          <a href="<%= verificationLink %>" style="color: var(--gold-light);"><%= verificationLink %></a>
        </div>
        <div style="text-align: center; margin-top: 1rem;">
          <a href="/auth/login" class="btn btn-gold" style="width: 100%;">🔐 Ir al Ingreso</a>
        </div>
      <% } else if (typeof success !== 'undefined' && success) { %>
        <div style="text-align: center; margin-top: 1rem;">
          <a href="/auth/login" class="btn btn-gold" style="width: 100%;">🔐 Ir al Ingreso</a>
        </div>
      <% } %>
    <% } else { %>
      <form action="/auth/registro" method="POST">
        <div class="form-group">
          <label class="form-label" for="full_name">Nombre Completo *</label>
          <input type="text" id="full_name" name="full_name" class="form-control" placeholder="EJ: ANA MARTÍNEZ" required style="text-transform: uppercase;" value="<%= typeof form !== 'undefined' && form ? form.full_name || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Correo Electrónico *</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="ana@escuelapatin.com" required value="<%= typeof form !== 'undefined' && form ? form.email || '' : '' %>">
          <small style="color: var(--text-muted);">Te enviaremos un enlace para verificar tus datos.</small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="username">Usuario (Login) *</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="profe.ana" required value="<%= typeof form !== 'undefined' && form ? form.username || '' : '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="phone">Teléfono</label>
            <input type="text" id="phone" name="phone" class="form-control" placeholder="+54 9 264 ..." value="<%= typeof form !== 'undefined' && form ? form.phone || '' : '' %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="password">Contraseña *</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Mínimo 6 caracteres" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm_password">Repetir Contraseña *</label>
            <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="••••••••" required>
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%;">
          📝 Crear Cuenta
        </button>
      </form>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(212,175,55,0.2); font-size: 0.85rem; color: var(--text-muted); text-align: center;">
        <p>¿Ya tenés una cuenta? <a href="/auth/login" style="color: var(--gold-light);">Ingresá aquí &rarr;</a></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
