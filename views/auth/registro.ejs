<%- include('../partials/header', { title: 'Crear Cuenta' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 480px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem; filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.4));">
      <h1 style="color: var(--gold-light); font-size: 1.6rem;">Crear Cuenta</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Registrate para cargar e inscribir tus patinadoras. Necesitás verificar tu email para ingresar.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-auto-dismiss">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        ✅ <%= success %>
      </div>
      <% if (typeof verificationLink !== 'undefined' && verificationLink) { %>
        <div class="alert alert-warning" style="word-break: break-all;">
          <strong>🔗 Enlace de verificación (válido 24 hs):</strong><br>
          <a href="<%= verificationLink %>" style="color: var(--gold-light);"><%= verificationLink %></a>
        </div>
        <div style="text-align: center; margin-top: 1rem;">
          <a href="/auth/login" class="btn btn-gold" style="width: 100%;">🔐 Ir al Ingreso</a>
        </div>
      <% } else if (typeof success !== 'undefined' && success) { %>
        <div style="text-align: center; margin-top: 1rem;">
          <a href="/auth/login" class="btn btn-gold" style="width: 100%;">🔐 Ir al Ingreso</a>
        </div>
      <% } %>
    <% } else { %>
      <form action="/auth/registro" method="POST">
        <div class="form-group">
          <label class="form-label" for="full_name">Nombre Completo *</label>
          <input type="text" id="full_name" name="full_name" class="form-control" placeholder="EJ: ANA MARTÍNEZ" required style="text-transform: uppercase;" value="<%= typeof form !== 'undefined' && form ? form.full_name || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Correo Electrónico *</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="ana@escuelapatin.com" required value="<%= typeof form !== 'undefined' && form ? form.email || '' : '' %>">
          <small style="color: var(--text-muted);">Te enviaremos un enlace para verificar tus datos.</small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="username">Usuario (Login) *</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="profe.ana" required value="<%= typeof form !== 'undefined' && form ? form.username || '' : '' %>">
          </div>

        <div class="form-group">
          <label class="form-label" for="phone">Teléfono</label>
          <input type="text" id="phone" name="phone" class="form-control" placeholder="+54 9 264 ..." value="<%= typeof form !== 'undefined' && form ? form.phone || '' : '' %>">
        </div>
      </div>

      <h3 style="color: var(--gold-light); margin: 1.25rem 0 0.5rem; font-size: 1.05rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;">
        🏛️ Clubes / Escuelas (creá uno o más)
      </h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem;">
          Cada club que crees queda vinculado a tu cuenta. Después podés crear más desde tu panel.
        </p>

        <div id="clubsContainer">
          <%
            let formClubs = [];
            if (typeof form !== 'undefined' && form && form.club_names) {
              const names = Array.isArray(form.club_names) ? form.club_names : [form.club_names];
              const cities = Array.isArray(form.club_cities) ? form.club_cities : (form.club_cities ? [form.club_cities] : []);
              formClubs = names.map((n, i) => ({ name: n, city: cities[i] || '' }));
            }
            if (formClubs.length === 0) formClubs = [{ name: '', city: '' }];
          %>
          <% formClubs.forEach((cl, idx) => { %>
            <div class="club-row form-row" style="border: 1px solid rgba(212,175,55,0.25); border-radius: var(--radius-sm); padding: 0.75rem; margin-bottom: 0.75rem; background: rgba(18,6,28,0.5);">
              <div class="form-group" style="flex: 2;">
                <label class="form-label">Nombre del Club / Escuela *</label>
                <input type="text" name="club_names[]" class="form-control" placeholder="EJ: CLUB DEPORTIVO ESTRELLA" style="text-transform: uppercase;" value="<%= cl.name %>" required>
              </div>
              <div class="form-group" style="flex: 1;">
                <label class="form-label">Ciudad / Provincia</label>
                <input type="text" name="club_cities[]" class="form-control" placeholder="EJ: SAN JUAN" style="text-transform: uppercase;" value="<%= cl.city %>">
              </div>
              <div style="display: flex; align-items: flex-end; padding-bottom: 0.35rem;">
                <button type="button" class="btn btn-secondary btn-sm club-row-remove" title="Quitar club">✕</button>
              </div>
            </div>
          <% }) %>
        </div>

        <div style="margin-bottom: 1rem;">
          <button type="button" class="btn btn-outline-gold btn-sm" id="btnAddClub">+ Agregar otro club</button>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="password">Contraseña *</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Mínimo 6 caracteres" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm_password">Repetir Contraseña *</label>
            <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="••••••••" required>
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%;">
          📝 Crear Cuenta
        </button>
      </form>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(212,175,55,0.2); font-size: 0.85rem; color: var(--text-muted); text-align: center;">
        <p>¿Ya tenés una cuenta? <a href="/auth/login" style="color: var(--gold-light);">Ingresá aquí &rarr;</a></p>
      </div>
    <% } %>
  </div>
</div>

<script>
  (function () {
    function clubRowHTML(name, city) {
      return '<div class="club-row form-row" style="border: 1px solid rgba(212,175,55,0.25); border-radius: var(--radius-sm); padding: 0.75rem; margin-bottom: 0.75rem; background: rgba(18,6,28,0.5);">' +
        '<div class="form-group" style="flex: 2;">' +
        '<label class="form-label">Nombre del Club / Escuela *</label>' +
        '<input type="text" name="club_names[]" class="form-control" placeholder="EJ: CLUB DEPORTIVO ESTRELLA" style="text-transform: uppercase;" value="' + (name || '') + '" required>' +
        '</div>' +
        '<div class="form-group" style="flex: 1;">' +
        '<label class="form-label">Ciudad / Provincia</label>' +
        '<input type="text" name="club_cities[]" class="form-control" placeholder="EJ: SAN JUAN" style="text-transform: uppercase;" value="' + (city || '') + '">' +
        '</div>' +
        '<div style="display: flex; align-items: flex-end; padding-bottom: 0.35rem;">' +
        '<button type="button" class="btn btn-secondary btn-sm club-row-remove" title="Quitar club">✕</button>' +
        '</div>' +
        '</div>';
    }

    function attachRemove(container) {
      container.querySelectorAll('.club-row-remove').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var row = btn.closest('.club-row');
          if (row) row.remove();
          if (container.querySelectorAll('.club-row').length === 0) {
            container.insertAdjacentHTML('beforeend', clubRowHTML('', ''));
            attachRemove(container);
          }
        });
      });
    }

    var container = document.getElementById('clubsContainer');
    if (!container) return;
    attachRemove(container);

    document.getElementById('btnAddClub').addEventListener('click', function () {
      container.insertAdjacentHTML('beforeend', clubRowHTML('', ''));
      attachRemove(container);
    });
  })();
</script>

<%- include('../partials/footer') %>
