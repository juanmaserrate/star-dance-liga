<%- include('../partials/header', { title: 'Recuperar Contraseña' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 450px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem;">
      <h1 style="color: var(--gold-light); font-size: 1.5rem;">🔑 Recuperar Contraseña</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        Ingresá tu correo electrónico o nombre de usuario registrado para recibir el enlace de restablecimiento.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">✅ <%= success %></div>
      <% if (typeof resetLink !== 'undefined' && resetLink) { %>
        <div style="margin-top: 1rem; background: rgba(18,6,28,0.8); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); word-break: break-all;">
          <small style="color: var(--gold-primary); font-weight: 700;">🔗 Enlace de Restablecimiento Directo:</small><br>
          <a href="<%= resetLink %>" style="color: var(--gold-light); font-size: 0.9rem;"><%= resetLink %></a>
        </div>
      <% } %>
    <% } %>

    <form action="/auth/olvide-password" method="POST" style="margin-top: 1rem;">
      <div class="form-group">
        <label class="form-label" for="email_or_username">Email o Nombre de Usuario</label>
        <input type="text" id="email_or_username" name="email_or_username" class="form-control" placeholder="Ej: profe.ana / ana@estrellapatin.com" required autofocus>
      </div>

      <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 1rem;">
        ✉️ Enviar Enlace de Recuperación
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center;">
      <a href="/auth/login" class="btn btn-secondary btn-sm">&larr; Volver a Iniciar Sesión</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
