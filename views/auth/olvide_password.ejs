<%- include('../partials/header', { title: 'Recuperar Contraseña' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 450px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem;">
      <h1 style="color: var(--gold-light); font-size: 1.5rem;">🔑 Recuperar Contraseña</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        Ingresá tu email registrado y te enviaremos un código de 6 dígitos para restablecer tu contraseña.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">✅ <%= success %></div>
      <% if (typeof resetCode !== 'undefined' && resetCode) { %>
        <div style="margin-top: 1rem; background: rgba(18,6,28,0.8); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); text-align: center;">
          <small style="color: var(--gold-primary); font-weight: 700;">🔑 Tu código de verificación:</small><br>
          <span style="color: var(--gold-light); font-weight: bold; font-size: 1.6rem; letter-spacing: 6px;"><%= resetCode %></span>
        </div>
      <% } %>
    <% } %>

    <form action="/auth/olvide-password" method="POST" style="margin-top: 1rem;">
      <div class="form-group">
        <label class="form-label" for="email">Email registrado</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" required autofocus>
      </div>

      <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 1rem;">
        ✉️ Enviar Código de Recuperación
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center;">
      <a href="/auth/login" class="btn btn-secondary btn-sm">&larr; Volver a Iniciar Sesión</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
