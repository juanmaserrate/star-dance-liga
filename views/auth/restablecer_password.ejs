<%- include('../partials/header', { title: 'Nueva Contraseña' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 440px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem;">
      <h1 style="color: var(--gold-light); font-size: 1.5rem;">🔐 Ingresar Nueva Contraseña</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Escribí tu nueva clave de acceso para actualizar tu cuenta.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="/auth/restablecer-password" method="POST">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="form-group">
        <label class="form-label" for="password">Nueva Contraseña *</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label" for="confirm_password">Confirmar Nueva Contraseña *</label>
        <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Repita la clave" required minlength="6">
      </div>

      <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 1rem;">
        💾 Guardar Nueva Contraseña e Iniciar Sesión
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
