<%- include('../partials/header', { title: 'Nueva Contraseña' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="card" style="width: 100%; max-width: 440px; border-top: 5px solid var(--gold-primary);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/img/logo.svg" alt="Star Dance" style="width: 70px; height: 70px; margin-bottom: 0.5rem;">
      <h1 style="color: var(--gold-light); font-size: 1.5rem;">🔐 Ingresar Nueva Contraseña</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Escribí tu nueva clave de acceso para actualizar tu cuenta.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="/auth/restablecer-password" method="POST">
      <div class="form-group">
        <label class="form-label" for="email">Email registrado</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" required value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>

      <div class="form-group">
        <label class="form-label" for="code">Código de verificación</label>
        <input type="text" id="code" name="code" class="form-control" placeholder="123456" required maxlength="64" autocomplete="one-time-code" value="<%= typeof code !== 'undefined' ? code : '' %>">
        <small style="color: var(--text-muted);">Recibiste este código en tu email al solicitar el restablecimiento.</small>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Nueva Contraseña *</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Tu nueva clave" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="confirm_password">Confirmar Nueva Contraseña *</label>
        <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Repita la clave" required>
      </div>

      <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 1rem;">
        💾 Guardar Nueva Contraseña
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
