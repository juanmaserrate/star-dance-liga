<%- include('../partials/header', { title: student && student.id ? 'Editar Patinadora' : 'Nueva Patinadora' }) %>
<%- include('profesor_shell', { activeNav: 'mis_alumnas', topbarSection: 'Mis Alumnas' }) %>


  <div class="card" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header">
      <h1 class="card-title">
        <%= student && student.id ? '✏️ Editar Ficha de Patinadora' : '👤 Alta de Patinadora' %>
      </h1>
      <a href="/profesor/dashboard" class="btn btn-secondary btn-sm">&larr; Volver al Padrón</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="<%= student && student.id ? '/profesor/alumnos/' + student.id + '/editar' : '/profesor/alumnos/nuevo' %>" method="POST" enctype="multipart/form-data">
      
      <h3 style="color: var(--gold-light); margin-bottom: 1rem; font-size: 1.1rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;">
        1. Datos Personales (Almacenamiento en MAYÚSCULAS)
      </h3>

      <!-- Apellido y Nombre van en campos separados a proposito. Antes habia
           uno solo y el sistema tenia que adivinar donde cortaba: si la
           profesora escribia "SOFIA MARTINEZ" quedaba SOFIA de apellido. -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="last_name">Apellido * <small style="color: var(--text-muted);">(ej: MARTINEZ)</small></label>
          <input type="text" id="last_name" name="last_name" class="form-control"
                 value="<%= student ? (student.last_name || '') : '' %>"
                 placeholder="EJ: MARTINEZ" required style="text-transform: uppercase;">
        </div>

        <div class="form-group">
          <label class="form-label" for="first_name">Nombre * <small style="color: var(--text-muted);">(ej: SOFIA)</small></label>
          <input type="text" id="first_name" name="first_name" class="form-control"
                 value="<%= student ? (student.first_name || '') : '' %>"
                 placeholder="EJ: SOFIA" required style="text-transform: uppercase;">
        </div>
      </div>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin: -0.4rem 0 1rem;">
        Cada uno en su casillero: así el apellido y el nombre salen bien en el Libro Mayor y en los certificados.
      </p>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="dni">DNI / Documento *</label>
          <input type="text" id="dni" name="dni" class="form-control" value="<%= student ? student.dni : '' %>" placeholder="Sin puntos" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="cuil">CUIL</label>
          <input type="text" id="cuil" name="cuil" class="form-control" value="<%= student ? student.cuil : '' %>" placeholder="EJ: 27-48123456-4">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="birth_date">Fecha de Nacimiento <small style="color: var(--text-muted);">(o cargá la Edad)</small></label>
          <input type="date" id="birth_date" name="birth_date" class="form-control" value="<%= student ? student.birth_date : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="edad">Edad (en años)</label>
          <input type="number" id="edad" name="edad" class="form-control" min="3" max="99" placeholder="EJ: 10">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="club_id">Club Perteneciente *</label>
        <select id="club_id" name="club_id" class="form-select" required>
          <% if (typeof myClubs !== 'undefined' && myClubs && myClubs.length > 0) { %>
            <% myClubs.forEach(c => { %>
              <option value="<%= c.id %>" <%= student && student.club_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          <% } else { %>
            <option value="1">CLUB DEPORTIVO ESTRELLA</option>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="category_default">Categoría de la Alumna</label>
        <select id="category_default" name="category_default" class="form-select">
          <option value="">-- Seleccionar categoría --</option>
          <%
            let prevDisc = null;
            (typeof categoryOptions !== 'undefined' ? categoryOptions : []).forEach(c => {
              if (c.discipline !== prevDisc) {
                if (prevDisc !== null) { %></optgroup><% }
                prevDisc = c.discipline;
                %><optgroup label="<%= c.discipline %>"><%
              }
              %><option value="<%= c.name %>" <%= student && student.category_default === c.name ? 'selected' : '' %>><%= c.label || c.name %></option><%
            });
            if (prevDisc !== null) { %></optgroup><% }
          %>
        </select>
      </div>

      <h3 style="color: var(--gold-light); margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1.1rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;">
        2. Cobertura Médica y Contacto de Emergencia (Obligatorios)
      </h3>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="health_insurance">Obra Social / Seguro de Salud *</label>
          <input type="text" id="health_insurance" name="health_insurance" class="form-control" value="<%= student ? student.health_insurance : '' %>" placeholder="EJ: OSDE / SWISS MEDICAL" required style="text-transform: uppercase;">
        </div>

        <div class="form-group">
          <label class="form-label" for="policy_number">N° de Afiliado / Póliza de Seguro *</label>
          <input type="text" id="policy_number" name="policy_number" class="form-control" value="<%= student ? student.policy_number : '' %>" placeholder="EJ: 987654321" required style="text-transform: uppercase;">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="emergency_contact">Contacto de Emergencia (Padre/Madre/Tutor)</label>
          <input type="text" id="emergency_contact" name="emergency_contact" class="form-control" value="<%= student ? student.emergency_contact : '' %>" placeholder="NOMBRE COMPLETO" style="text-transform: uppercase;">
        </div>

        <div class="form-group">
          <label class="form-label" for="emergency_phone">Teléfono de Emergencia de Contacto</label>
          <input type="text" id="emergency_phone" name="emergency_phone" class="form-control" value="<%= student ? student.emergency_phone : '' %>" placeholder="EJ: +54 9 264 ...">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="medical_notes">Observaciones Médicas / Ficha Técnica</label>
        <textarea id="medical_notes" name="medical_notes" class="form-control" rows="2" placeholder="ALERGIAS, MEDICAMENTOS, APTO MÉDICO..." style="text-transform: uppercase;"><%= student ? student.medical_notes : '' %></textarea>
      </div>

      <h3 style="color: var(--gold-light); margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1.1rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;">
        3. Adjuntar Apto Médico o Documentación (Opcional)
      </h3>

      <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
        <div style="margin-bottom: 1rem; background: rgba(18,6,28,0.6); padding: 0.85rem; border-radius: var(--radius-sm);">
          <strong style="color: var(--gold-primary);">Archivos adjuntos actuales:</strong>
          <ul style="margin-top: 0.5rem; margin-left: 1.25rem;">
            <% documents.forEach(d => { %>
              <li>
                <a href="<%= d.file_path %>" target="_blank" style="color: var(--gold-light);">📄 <%= d.title %></a> 
                <small style="color: var(--text-muted);">(<%= d.uploaded_at %>)</small>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="doc_title">Título del Archivo</label>
          <input type="text" id="doc_title" name="doc_title" class="form-control" placeholder="EJ: APTO MÉDICO 2026" style="text-transform: uppercase;">
        </div>

        <div class="form-group">
          <label class="form-label" for="documento">Seleccionar Archivo (PDF / Imagen)</label>
          <input type="file" id="documento" name="documento" class="form-control" accept=".pdf,.png,.jpg,.jpeg">
        </div>
      </div>

      <div style="margin-top: 2rem; display: flex; gap: 1rem;">
        <button type="submit" class="btn btn-gold" style="flex: 1;">
          💾 <%= student && student.id ? 'Guardar Cambios' : 'Registrar Patinadora' %>
        </button>
        <a href="/profesor/dashboard" class="btn btn-secondary">Cancelar</a>
      </div>

    </form>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const birthInput = document.getElementById('birth_date');
    const edadInput = document.getElementById('edad');
    if (!birthInput || !edadInput) return;

    const calcAge = () => {
      if (!birthInput.value) { edadInput.value = ''; return; }
      const b = new Date(birthInput.value);
      const now = new Date();
      let age = now.getFullYear() - b.getFullYear();
      if (now.getMonth() < b.getMonth() || (now.getMonth() === b.getMonth() && now.getDate() < b.getDate())) age--;
      edadInput.value = age >= 0 ? age : '';
    };

    calcAge();
    birthInput.addEventListener('change', calcAge);
  });
</script>

<%- include('../partials/footer') %>
