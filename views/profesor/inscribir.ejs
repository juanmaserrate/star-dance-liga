<%- include('../partials/header', { title: 'Inscribir Alumna / Grupo' }) %>
<%- include('profesor_shell', { activeNav: 'inscribir', topbarSection: 'Inscribir a Torneo' }) %>


  <div class="card" style="max-width: 850px; margin: 0 auto;">
    <div class="card-header">
      <h1 class="card-title">✍️ Inscripción a Torneo (Individual o Grupal)</h1>
      <a href="/profesor/dashboard" class="btn btn-secondary btn-sm">&larr; Volver al Panel</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="/profesor/inscribir" method="POST" id="enrollmentForm">
      
      <!-- Select Tournament -->
      <div class="form-group">
        <label class="form-label" for="tournament_select">1. Seleccionar Torneo *</label>
        <select id="tournament_select" class="form-select" onchange="window.location.href='/profesor/inscribir?tournament_id=' + this.value + '<%= preselectedStudentId ? '&student_id=' + preselectedStudentId : '' %>'" required>
          <% activeTournaments.forEach(t => { %>
            <option value="<%= t.id %>" <%= (selectedTournamentId == t.id) ? 'selected' : '' %>>
              <%= t.name %> (📅 <%= t.datesLabel %> - 📍 <%= t.venue %>)
            </option>
          <% }) %>
        </select>
        <input type="hidden" name="tournament_id" value="<%= selectedTournamentId %>">
      </div>

      <!-- Select Discipline -->
      <div class="form-group">
        <label class="form-label" for="discipline_select">2. Seleccionar Disciplina *</label>
        <% if (typeof disciplines !== 'undefined' && disciplines && disciplines.length > 0) { %>
          <select id="discipline_select" class="form-select" required>
            <option value="">-- Seleccionar Disciplina --</option>
            <% disciplines.forEach(d => { %>
              <option value="<%= d %>"><%= d %></option>
            <% }) %>
          </select>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No hay categorías creadas para este torneo.</p>
        <% } %>
      </div>

      <!-- Select Age (solo se habilita para disciplinas con franjas de edad) -->
      <div class="form-group" id="age_band_group">
        <label class="form-label" for="age_band">3. Seleccionar Edad *</label>
        <select id="age_band" name="age_band" class="form-select" required disabled>
          <option value="">-- Seleccionar Edad --</option>
        </select>
      </div>

      <!-- Select Category (filtered by discipline) -->
      <div class="form-group">
        <label class="form-label" for="category_id">4. Seleccionar Categoría *</label>
        <% if (categories && categories.length > 0) { %>
          <select id="category_id" name="category_id" class="form-select" onchange="autoDetectDisciplineType(this)" required disabled data-all-categories='<%- JSON.stringify(categories.map(c => ({ id: c.id, label: c.label || c.name, discipline: c.discipline }))) %>'></select>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No hay categorías creadas para este torneo.</p>
        <% } %>
      </div>

      <!-- Registration Type -->
      <div class="form-group">
        <label class="form-label" for="group_type">5. Tipo de Inscripción *</label>
        <select id="group_type" name="group_type" class="form-select" onchange="updateRowVisibility()">
          <option value="Individual">Individual (1 Patinadora)</option>
          <option value="Dúo">Dúo (2 Patinadoras)</option>
          <option value="Trío">Trío (3 Patinadoras)</option>
          <option value="Cuarteto">Cuarteto (4 Patinadoras)</option>
          <option value="Small">Small Group (Hasta 6 Patinadoras)</option>
          <option value="Show">Show (Hasta 30 Patinadoras)</option>
          <option value="Precisión">Precisión (Hasta 30 Patinadoras)</option>
          <option value="Parejas Mixtas">Parejas Mixtas (2 Patinadores)</option>
        </select>
      </div>

      <!-- Select Students Line-by-Line -->
      <div class="form-group" id="student_selection_box">
        <label class="form-label" id="participants_label">6. Seleccionar Patinadora *</label>
        <small id="group_info_help" style="color: var(--gold-light); display: none; margin-bottom: 0.5rem;">
          ℹ️ En disciplinas grupales o parejas, la categoría y edad del grupo se evalúan según la participante de mayor categoría o edad.
        </small>

        <% if (students && students.length > 0) { %>
          <div id="student_rows" style="display: flex; flex-direction: column; gap: 0.65rem;"></div>
        <% } else { %>
          <div class="alert alert-danger" style="margin-top: 0.5rem;">
            No tienes patinadoras en tu padrón. <a href="/profesor/alumnos/nuevo" style="color: white; text-decoration: underline">Carga una aquí primero</a>.
          </div>
        <% } %>
      </div>

      <!-- Club de la Inscripción -->
      <div class="form-group">
        <label class="form-label" for="club_id">7. Club de la Inscripción *</label>
        <select id="club_id" name="club_id" class="form-select">
          <% if (typeof myClubs !== 'undefined' && myClubs && myClubs.length > 0) { %>
            <% myClubs.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          <% } else { %>
            <option value="">-- No tenés clubes asignados --</option>
          <% } %>
        </select>
        <small style="color: var(--text-muted);">Se usa el club de la patinadora seleccionada si no lo cambiás.</small>
      </div>

      <!-- Group Fantasy Name (Hidden when Individual) -->
      <div class="form-group" id="group_name_box" style="display: none;">
        <label class="form-label" for="group_name">Nombre de Fantasía del Grupo / Pareja *</label>
        <input type="text" id="group_name" name="group_name" class="form-control" placeholder="EJ: LAS ESTRELLAS DEL SUR" style="text-transform: uppercase;">
      </div>

      <div class="form-group">
        <label class="form-label" for="notes">Notas o Comentarios de la Inscripción</label>
        <input type="text" id="notes" name="notes" class="form-control" placeholder="EJ: MÚSICA ENVIADA / PISTAS">
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="btn btn-gold" style="width: 100%; font-size: 1.1rem;" <%= (!students || students.length === 0 || !categories || categories.length === 0) ? 'disabled' : '' %>>
          ✨ Confirmar
        </button>
      </div>

    </form>
  </div>
</main>

<script>
  const STUDENTS = <%- JSON.stringify(students.map(s => ({ id: s.id, first_name: s.first_name, last_name: s.last_name, dni: s.dni, age: s.age, club_name: s.club_name }))).replace(/</g, '\\u003c') %>;
  const PRESELECTED_ID = <%- JSON.stringify(preselectedStudentId || null) %>;

  const MAX_BY_TYPE = {
    'Individual': 1,
    'Dúo': 2,
    'Parejas Mixtas': 2,
    'Trío': 3,
    'Cuarteto': 4,
    'Small': 6,
    'Show': 30,
    'Precisión': 30
  };

  function ordinal(n) {
    const map = { 1: '1ra', 2: '2da', 3: '3ra', 4: '4ta', 5: '5ta', 6: '6ta', 7: '7ma', 8: '8va', 9: '9na', 10: '10ma' };
    return map[n] || (n + '°');
  }

  // Genera los renglones de patinadoras según el máximo que permite el tipo (hasta 30)
  function buildStudentRows(max) {
    const container = document.getElementById('student_rows');
    if (!container) return;

    const prev = {};
    container.querySelectorAll('select[name="student_ids"]').forEach((s, i) => {
      if (s.value) prev[i + 1] = s.value;
    });

    container.innerHTML = '';
    for (let i = 1; i <= max; i++) {
      const row = document.createElement('div');
      row.id = 'row_' + i;
      row.style.cssText = 'display: flex; gap: 0.5rem; align-items: center;';

      const label = document.createElement('span');
      label.style.cssText = 'font-weight: 700; color: var(--gold-primary); min-width: 90px;';
      label.textContent = max === 1 ? 'Patinadora:' : 'Renglón ' + i + ':';

      const sel = document.createElement('select');
      sel.name = 'student_ids';
      sel.id = 'student_select_' + i;
      sel.className = 'form-select';
      if (i === 1) sel.required = true;

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = max === 1
        ? '-- Seleccionar Patinadora --'
        : (i === 1 ? '-- Seleccionar 1ra Patinadora --' : '-- Seleccionar ' + ordinal(i) + ' Patinadora --');
      sel.appendChild(placeholder);

      STUDENTS.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.last_name + ', ' + s.first_name + ' (DNI: ' + s.dni + ' | ' + s.age + ' AÑOS | ' + s.club_name + ')';
        if (i === 1 && PRESELECTED_ID && String(PRESELECTED_ID) === String(s.id)) opt.selected = true;
        sel.appendChild(opt);
      });

      if (prev[i]) sel.value = prev[i];

      row.appendChild(label);
      row.appendChild(sel);
      container.appendChild(row);
    }
    filterSelectedStudents();
  }

  function autoDetectDisciplineType(selectElem) {
    const selectedOption = selectElem.options[selectElem.selectedIndex];
    if (!selectedOption) return;

    const disc = (selectedOption.getAttribute('data-discipline') || '').toUpperCase();
    const groupSelect = document.getElementById('group_type');

    if (disc.includes('DÚO')) {
      groupSelect.value = 'Dúo';
    } else if (disc.includes('TRÍO')) {
      groupSelect.value = 'Trío';
    } else if (disc.includes('CUARTETO')) {
      groupSelect.value = 'Cuarteto';
    } else if (disc.includes('PAREJA')) {
      groupSelect.value = 'Parejas Mixtas';
    } else if (disc.includes('SMALL')) {
      groupSelect.value = 'Small';
    } else if (disc.includes('SHOW')) {
      groupSelect.value = 'Show';
    } else if (disc.includes('PRECISIÓN')) {
      groupSelect.value = 'Precisión';
    } else {
      groupSelect.value = 'Individual';
    }

    updateRowVisibility();
  }

  const AGE_BANDS = <%- typeof ageBandsByDiscipline !== 'undefined' ? JSON.stringify(ageBandsByDiscipline).replace(/</g, '\\u003c') : '{}' %>;

  // Normaliza el nombre de la disciplina (mayúsculas y sin tildes) para emparejar
  // de forma tolerante los valores de la base con las claves del catálogo.
  function normalizeDisc(s) {
    return String(s || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  }
  const AGE_BANDS_NORM = {};
  Object.keys(AGE_BANDS).forEach(k => { AGE_BANDS_NORM[normalizeDisc(k)] = AGE_BANDS[k]; });

  function filterCategoriesByDiscipline() {
    const discSelect = document.getElementById('discipline_select');
    const catSelect = document.getElementById('category_id');
    const ageGroup = document.getElementById('age_band_group');
    const ageSelect = document.getElementById('age_band');
    if (!discSelect || !catSelect) return;

    const selectedDisc = discSelect.value;
    const allCategories = catSelect.dataset.allCategories ? JSON.parse(catSelect.dataset.allCategories) : [];

    // Poblar el desplegable de Edad según la disciplina (si tiene franjas de edad)
    const bands = selectedDisc ? (AGE_BANDS_NORM[normalizeDisc(selectedDisc)] || []) : [];
    if (ageSelect) {
      ageSelect.innerHTML = '';
      if (bands.length > 0) {
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '-- Seleccionar Edad --';
        ageSelect.appendChild(placeholder);
        bands.forEach(b => {
          const opt = document.createElement('option');
          opt.value = b.name;
          opt.textContent = `${b.name} (${b.min}-${b.max})`;
          ageSelect.appendChild(opt);
        });
        ageSelect.disabled = false;
      } else {
        const note = document.createElement('option');
        note.value = '';
        note.textContent = '-- Sin franjas de edad para esta disciplina --';
        ageSelect.appendChild(note);
        ageSelect.disabled = true;
      }
      ageSelect.value = '';
    }
    if (ageGroup) ageGroup.style.display = 'block';

    catSelect.innerHTML = '';

    (allCategories || []).forEach(c => {
      if (!selectedDisc || c.discipline === selectedDisc) {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.setAttribute('data-discipline', c.discipline);
        opt.textContent = c.label || c.name;
        catSelect.appendChild(opt);
      }
    });

    if (catSelect.options.length > 0) {
      catSelect.disabled = false;
    } else {
      catSelect.disabled = true;
      catSelect.innerHTML = '<option value="">-- No hay categorías en esta disciplina --</option>';
    }
    catSelect.value = '';
  }

  // Acopla la disciplina con el tipo de inscripción permitido
  function filterGroupTypesByDiscipline(disc) {
    const d = (disc || '').toUpperCase();
    let allowed = ['Individual'];
    if (d.includes('DÚO')) allowed = ['Dúo'];
    else if (d.includes('TRÍO')) allowed = ['Trío'];
    else if (d.includes('CUARTETO')) allowed = ['Cuarteto'];
    else if (d.includes('PAREJA')) allowed = ['Parejas Mixtas'];
    else if (d.includes('SMALL')) allowed = ['Small'];
    else if (d.includes('SHOW')) allowed = ['Show'];
    else if (d.includes('PRECISIÓN')) allowed = ['Precisión'];

    const groupSelect = document.getElementById('group_type');
    const labels = {
      'Individual': 'Individual (1 Patinadora)',
      'Dúo': 'Dúo (2 Patinadoras)',
      'Trío': 'Trío (3 Patinadoras)',
      'Cuarteto': 'Cuarteto (4 Patinadoras)',
      'Small': 'Small Group (Hasta 6 Patinadoras)',
      'Show': 'Show (Hasta 30 Patinadoras)',
      'Precisión': 'Precisión (Hasta 30 Patinadoras)',
      'Parejas Mixtas': 'Parejas Mixtas (2 Patinadores)'
    };

    groupSelect.innerHTML = '';
    allowed.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = labels[t] || t;
      groupSelect.appendChild(opt);
    });
    groupSelect.value = allowed[0];
    updateRowVisibility();
  }

  function updateRowVisibility() {
    const type = document.getElementById('group_type').value;
    const max = MAX_BY_TYPE[type] || 1;

    const groupNameBox = document.getElementById('group_name_box');
    const helpText = document.getElementById('group_info_help');
    const mainLabel = document.getElementById('participants_label');

    if (type === 'Individual') {
      mainLabel.innerText = '6. Seleccionar Patinadora *';
      helpText.style.display = 'none';
      groupNameBox.style.display = 'none';
    } else {
      mainLabel.innerText = '6. Seleccionar Patinadoras del Grupo (Línea por Línea) *';
      helpText.style.display = 'block';
      groupNameBox.style.display = 'block';
    }

    buildStudentRows(max);
  }

  function filterSelectedStudents() {
    const container = document.getElementById('student_rows');
    if (!container) return;
    const selects = Array.from(container.querySelectorAll('select[name="student_ids"]'));

    const selectedValues = selects.map(s => s.value).filter(v => v !== '');

    selects.forEach(currentSelect => {
      const currentValue = currentSelect.value;
      currentSelect.querySelectorAll('option').forEach(opt => {
        if (opt.value === '') return; // Never disable placeholder

        // Disable this option if it's selected in any other dropdown
        if (selectedValues.includes(opt.value) && opt.value !== currentValue) {
          opt.disabled = true;
        } else {
          opt.disabled = false;
        }
      });
    });
  }

  // Attach event listeners (delegación: no hace falta re-adjuntar por renglón)
  document.addEventListener('DOMContentLoaded', () => {
    updateRowVisibility();

    const disciplineSelect = document.getElementById('discipline_select');
    if (disciplineSelect) {
      disciplineSelect.addEventListener('change', filterCategoriesByDiscipline);
      disciplineSelect.addEventListener('change', () => filterGroupTypesByDiscipline(disciplineSelect.value));
      filterGroupTypesByDiscipline(disciplineSelect.value);
    }

    const container = document.getElementById('student_rows');
    if (container) {
      container.addEventListener('change', (e) => {
        if (e.target && e.target.name === 'student_ids') filterSelectedStudents();
      });
    }
  });
</script>

<%- include('../partials/footer') %>
