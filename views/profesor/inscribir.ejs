<%- include('../partials/header', { title: 'Inscribir Alumna / Grupo' }) %>
<%- include('profesor_shell', { activeNav: 'inscribir', topbarSection: 'Inscribir a Torneo' }) %>


  <div class="card" style="max-width: 850px; margin: 0 auto;">
    <div class="card-header">
      <h1 class="card-title">✍️ Inscripción a Torneo (Individual o Grupal)</h1>
      <a href="/profesor/dashboard" class="btn btn-secondary btn-sm">&larr; Volver al Panel</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="/profesor/inscribir" method="POST" id="enrollmentForm">

      <!-- Torneo -->
      <div class="form-group">
        <label class="form-label" for="tournament_select">Torneo *</label>
        <select id="tournament_select" class="form-select" onchange="window.location.href='/profesor/inscribir?tournament_id=' + this.value + '<%= preselectedStudentId ? '&student_id=' + preselectedStudentId : '' %>'" required>
          <% activeTournaments.forEach(t => { %>
            <option value="<%= t.id %>" <%= (selectedTournamentId == t.id) ? 'selected' : '' %>>
              <%= t.name %> (📅 <%= t.datesLabel %> - 📍 <%= t.venue %>)
            </option>
          <% }) %>
        </select>
        <input type="hidden" name="tournament_id" value="<%= selectedTournamentId %>">
      </div>

      <!-- 1. Disciplina (define si es una sola patinadora o varias) -->
      <div class="form-group">
        <label class="form-label" for="discipline_select">1. Seleccionar Disciplina *</label>
        <% if (typeof disciplines !== 'undefined' && disciplines && disciplines.length > 0) { %>
          <select id="discipline_select" class="form-select" required>
            <option value="">-- Seleccionar Disciplina --</option>
            <% disciplines.forEach(d => { %>
              <option value="<%= d %>"><%= d %></option>
            <% }) %>
          </select>
          <small style="color: var(--text-muted);">La disciplina define si se inscribe una sola patinadora o un grupo.</small>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No hay categorías creadas para este torneo.</p>
        <% } %>
      </div>

      <!-- Tipo de inscripción: se oculta en LIBRE y FREE DANCE (siempre individual) -->
      <div class="form-group" id="group_type_box">
        <label class="form-label" for="group_type">Tipo de Inscripción *</label>
        <select id="group_type" name="group_type" class="form-select" onchange="updateRowVisibility()">
          <option value="Individual">Individual (1 Patinadora)</option>
          <option value="Dúo">Dúo (2 Patinadoras)</option>
          <option value="Trío">Trío (3 Patinadoras)</option>
          <option value="Cuarteto">Cuarteto (4 Patinadoras)</option>
          <option value="Small">Small Group (Hasta 6 Patinadoras)</option>
          <option value="Show">Show (Hasta 30 Patinadoras)</option>
          <option value="Precisión">Precisión (Hasta 30 Patinadoras)</option>
          <option value="Parejas Mixtas">Parejas Mixtas (2 Patinadores)</option>
        </select>
      </div>

      <!-- 2. Seleccionar alumna(s) -->
      <div class="form-group" id="student_selection_box">
        <label class="form-label" id="participants_label">2. Seleccionar Alumna *</label>
        <small id="group_info_help" style="color: var(--gold-light); display: none; margin-bottom: 0.5rem;">
          ℹ️ En disciplinas grupales o parejas, la categoría y edad del grupo se evalúan según la participante de mayor categoría o edad.
        </small>

        <% if (students && students.length > 0) { %>
          <div id="student_rows" style="display: flex; flex-direction: column; gap: 0.65rem;"></div>
        <% } else { %>
          <div class="alert alert-danger" style="margin-top: 0.5rem;">
            No tienes patinadoras en tu padrón. <a href="/profesor/alumnos/nuevo" style="color: white; text-decoration: underline">Carga una aquí primero</a>.
          </div>
        <% } %>
      </div>

      <!-- Reglamento: solo en las disciplinas que se dividen por reglamento
           (ADULTOS). Define qué categorías se ofrecen abajo. -->
      <div class="form-group" id="ruleset_box" style="display: none;">
        <label class="form-label" for="ruleset">Reglamento *</label>
        <select id="ruleset" name="ruleset" class="form-select">
          <option value="">-- Seleccionar Reglamento --</option>
        </select>
        <small style="color: var(--text-muted);">Cada reglamento tiene sus propias categorías.</small>
      </div>

      <!-- 3. Categoría -->
      <div class="form-group">
        <label class="form-label" for="category_id">3. Seleccionar Categoría *</label>
        <% if (categories && categories.length > 0) { %>
          <select id="category_id" name="category_id" class="form-select" required disabled data-all-categories='<%- JSON.stringify(categories.map(c => ({ id: c.id, label: c.label || c.name, discipline: c.discipline, ruleset: c.ruleset || null }))) %>'></select>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No hay categorías creadas para este torneo.</p>
        <% } %>
      </div>

      <!-- 4. Edad: se trae sola de la ficha de la alumna y se puede corregir -->
      <div class="form-group">
        <label class="form-label" for="age">4. Edad *</label>
        <input type="number" id="age" name="age" class="form-control" min="1" max="120" placeholder="Se completa al elegir la alumna">
        <small style="color: var(--text-muted);">Se toma automáticamente de la ficha de la patinadora. Podés corregirla si hace falta.</small>
      </div>

      <!-- 5. Categoría de edad: la asigna la franja donde cae la edad; editable -->
      <div class="form-group" id="age_band_group">
        <label class="form-label" for="age_band">5. Categoría de Edad</label>
        <select id="age_band" name="age_band" class="form-select" disabled>
          <option value="">-- Seleccioná primero una disciplina --</option>
        </select>
        <small id="age_band_help" style="color: var(--text-muted);">Se asigna sola según la edad. Podés elegir otra del desplegable.</small>
      </div>

      <!-- 6. Club: se trae del de la alumna -->
      <div class="form-group">
        <label class="form-label" for="club_id">6. Club de la Inscripción *</label>
        <select id="club_id" name="club_id" class="form-select">
          <% if (typeof myClubs !== 'undefined' && myClubs && myClubs.length > 0) { %>
            <% myClubs.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          <% } else { %>
            <option value="">-- No tenés clubes asignados --</option>
          <% } %>
        </select>
        <small style="color: var(--text-muted);">Se completa con el club de la patinadora seleccionada. Podés cambiarlo.</small>
      </div>

      <!-- Group Fantasy Name (Hidden when Individual) -->
      <div class="form-group" id="group_name_box" style="display: none;">
        <label class="form-label" for="group_name">Nombre de Fantasía del Grupo / Pareja *</label>
        <input type="text" id="group_name" name="group_name" class="form-control" placeholder="EJ: LAS ESTRELLAS DEL SUR" style="text-transform: uppercase;">
      </div>

      <div class="form-group">
        <label class="form-label" for="notes">Notas o Comentarios de la Inscripción</label>
        <input type="text" id="notes" name="notes" class="form-control" placeholder="EJ: MÚSICA ENVIADA / PISTAS">
      </div>

      <!-- Aviso de inscripción repetida en este torneo -->
      <div id="dup_warning" class="alert alert-danger" style="display: none;"></div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="btn btn-gold" style="width: 100%; font-size: 1.1rem;" <%= (!students || students.length === 0 || !categories || categories.length === 0) ? 'disabled' : '' %>>
          ✨ Confirmar
        </button>
      </div>

    </form>
  </div>
</main>

<script>
  const STUDENTS = <%- JSON.stringify(students.map(s => ({ id: s.id, first_name: s.first_name, last_name: s.last_name, dni: s.dni, age: s.age, club_id: s.club_id, club_name: s.club_name }))).replace(/</g, '\\u003c') %>;
  const PRESELECTED_ID = <%- JSON.stringify(preselectedStudentId || null) %>;
  const AGE_BANDS = <%- typeof ageBandsByDiscipline !== 'undefined' ? JSON.stringify(ageBandsByDiscipline).replace(/</g, '\\u003c') : '{}' %>;
  const RULESETS = <%- typeof rulesetsByDiscipline !== 'undefined' ? JSON.stringify(rulesetsByDiscipline).replace(/</g, '\\u003c') : '{}' %>;

  // Pares "alumna|categoría" ya ocupados EN ESTE TORNEO. Sirve para avisar antes
  // de confirmar; el servidor igual lo vuelve a chequear al guardar.
  const YA_INSCRIPTAS = new Set(
    (<%- typeof yaInscriptas !== 'undefined' ? JSON.stringify(yaInscriptas).replace(/</g, '\\u003c') : '[]' %>)
      .map(x => String(x.student_id) + '|' + String(x.category_id))
  );

  // Disciplinas que siempre son individuales y por lo tanto NO muestran el
  // desplegable de tipo de inscripción.
  const HIDE_TYPE_DISCIPLINES = ['LIBRE', 'FREE DANCE', 'ADULTOS'];

  const MAX_BY_TYPE = {
    'Individual': 1,
    'Dúo': 2,
    'Parejas Mixtas': 2,
    'Trío': 3,
    'Cuarteto': 4,
    'Small': 6,
    'Show': 30,
    'Precisión': 30
  };

  // Normaliza el nombre de la disciplina (mayúsculas y sin tildes) para emparejar
  // de forma tolerante los valores de la base con las claves del catálogo.
  function normalizeDisc(s) {
    return String(s || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  }

  const AGE_BANDS_NORM = {};
  Object.keys(AGE_BANDS).forEach(k => { AGE_BANDS_NORM[normalizeDisc(k)] = AGE_BANDS[k]; });

  const RULESETS_NORM = {};
  Object.keys(RULESETS).forEach(k => { RULESETS_NORM[normalizeDisc(k)] = RULESETS[k]; });

  function currentDiscipline() {
    const sel = document.getElementById('discipline_select');
    return sel ? sel.value : '';
  }

  function currentBands() {
    return AGE_BANDS_NORM[normalizeDisc(currentDiscipline())] || [];
  }

  // Reglamentos disponibles para la disciplina elegida (vacío si no usa).
  function currentRulesets() {
    return RULESETS_NORM[normalizeDisc(currentDiscipline())] || [];
  }

  function currentRuleset() {
    const sel = document.getElementById('ruleset');
    return sel ? sel.value : '';
  }

  // Muestra el desplegable de Reglamento solo en las disciplinas que lo usan.
  function populateRulesets() {
    const box = document.getElementById('ruleset_box');
    const sel = document.getElementById('ruleset');
    if (!box || !sel) return;

    const list = currentRulesets();
    if (!list.length) {
      box.style.display = 'none';
      sel.innerHTML = '<option value=""></option>';
      sel.required = false;
      sel.value = '';
      return;
    }

    sel.innerHTML = '';
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = '-- Seleccionar Reglamento --';
    sel.appendChild(placeholder);

    list.forEach(r => {
      const opt = document.createElement('option');
      opt.value = r;
      opt.textContent = r;
      sel.appendChild(opt);
    });

    sel.value = '';
    sel.required = true;
    box.style.display = 'block';
  }

  function ordinal(n) {
    const map = { 1: '1ra', 2: '2da', 3: '3ra', 4: '4ta', 5: '5ta', 6: '6ta', 7: '7ma', 8: '8va', 9: '9na', 10: '10ma' };
    return map[n] || (n + '°');
  }

  // Etiqueta legible de la franja de edad: "6 y 7 años", "18 años", "78 años y más"
  function ageBandLabel(b) {
    if (b.max >= 99) return b.name + ' (' + b.min + ' años y más)';
    if (b.min === b.max) return b.name + ' (' + b.min + ' años)';
    return b.name + ' (' + b.min + ' a ' + b.max + ' años)';
  }

  // Genera los renglones de patinadoras según el máximo que permite el tipo (hasta 30)
  function buildStudentRows(max) {
    const container = document.getElementById('student_rows');
    if (!container) return;

    const prev = {};
    container.querySelectorAll('select[name="student_ids"]').forEach((s, i) => {
      if (s.value) prev[i + 1] = s.value;
    });

    container.innerHTML = '';
    for (let i = 1; i <= max; i++) {
      const row = document.createElement('div');
      row.id = 'row_' + i;
      row.style.cssText = 'display: flex; gap: 0.5rem; align-items: center;';

      const label = document.createElement('span');
      label.style.cssText = 'font-weight: 700; color: var(--gold-primary); min-width: 90px;';
      label.textContent = max === 1 ? 'Alumna:' : 'Renglón ' + i + ':';

      const sel = document.createElement('select');
      sel.name = 'student_ids';
      sel.id = 'student_select_' + i;
      sel.className = 'form-select';
      if (i === 1) sel.required = true;

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = max === 1
        ? '-- Seleccionar Alumna --'
        : (i === 1 ? '-- Seleccionar 1ra Patinadora --' : '-- Seleccionar ' + ordinal(i) + ' Patinadora --');
      sel.appendChild(placeholder);

      STUDENTS.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        // Apellido primero y bien separado del nombre, para elegir sin dudar
        opt.textContent = s.last_name + ', ' + s.first_name +
          '  —  DNI ' + s.dni + ' · ' + s.age + ' años · ' + s.club_name;
        if (i === 1 && PRESELECTED_ID && String(PRESELECTED_ID) === String(s.id)) opt.selected = true;
        sel.appendChild(opt);
      });

      if (prev[i]) sel.value = prev[i];

      row.appendChild(label);
      row.appendChild(sel);
      container.appendChild(row);
    }
    filterSelectedStudents();
    applyStudentDefaults();
  }

  // Patinadora principal: la del primer renglón. En grupos, la de mayor edad.
  function primaryStudent() {
    const container = document.getElementById('student_rows');
    if (!container) return null;
    const ids = Array.from(container.querySelectorAll('select[name="student_ids"]'))
      .map(s => s.value).filter(Boolean);
    if (!ids.length) return null;

    const chosen = ids.map(id => STUDENTS.find(s => String(s.id) === String(id))).filter(Boolean);
    if (!chosen.length) return null;
    return chosen.reduce((a, b) => (Number(b.age) > Number(a.age) ? b : a));
  }

  // Al elegir la alumna: se traen su edad y su club automáticamente.
  function applyStudentDefaults() {
    const student = primaryStudent();
    if (!student) return;

    const ageInput = document.getElementById('age');
    if (ageInput) {
      ageInput.value = student.age || '';
      applyAgeBandFromAge();
    }

    const clubSelect = document.getElementById('club_id');
    if (clubSelect && student.club_id) {
      const match = Array.from(clubSelect.options).find(o => String(o.value) === String(student.club_id));
      if (match) clubSelect.value = String(student.club_id);
    }
  }

  // Rellena el desplegable de Categoría de Edad con las franjas de la disciplina.
  function populateAgeBands() {
    const ageSelect = document.getElementById('age_band');
    const help = document.getElementById('age_band_help');
    if (!ageSelect) return;

    const disc = currentDiscipline();
    const bands = currentBands();
    ageSelect.innerHTML = '';

    if (!bands.length) {
      const note = document.createElement('option');
      note.value = '';
      note.textContent = disc
        ? '-- Esta disciplina no usa categorías de edad --'
        : '-- Seleccioná primero una disciplina --';
      ageSelect.appendChild(note);
      ageSelect.disabled = true;
      if (help) {
        help.textContent = disc
          ? 'Esta disciplina no tiene categorías de edad configuradas.'
          : 'Se completa sola cuando elijas la disciplina y la alumna.';
      }
      return;
    }

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = '-- Seleccionar Categoría de Edad --';
    ageSelect.appendChild(placeholder);

    bands.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b.name;
      opt.textContent = ageBandLabel(b);
      ageSelect.appendChild(opt);
    });
    ageSelect.disabled = false;
    if (help) help.textContent = 'Se asigna sola según la edad. Podés elegir otra del desplegable.';
  }

  // Asigna la categoría de edad según en qué franja cae la edad cargada.
  function applyAgeBandFromAge() {
    const ageInput = document.getElementById('age');
    const ageSelect = document.getElementById('age_band');
    if (!ageInput || !ageSelect || ageSelect.disabled) return;

    const age = parseInt(ageInput.value, 10);
    if (!Number.isFinite(age)) return;

    const band = currentBands().find(b => age >= b.min && age <= b.max);
    ageSelect.value = band ? band.name : '';
  }

  function filterCategoriesByDiscipline() {
    const discSelect = document.getElementById('discipline_select');
    const catSelect = document.getElementById('category_id');
    if (!discSelect || !catSelect) return;

    const selectedDisc = discSelect.value;
    const allCategories = catSelect.dataset.allCategories ? JSON.parse(catSelect.dataset.allCategories) : [];

    catSelect.innerHTML = '';

    if (!selectedDisc) {
      catSelect.innerHTML = '<option value="">-- Primero elegí una disciplina --</option>';
      catSelect.disabled = true;
      return;
    }

    // En las disciplinas con reglamento (ADULTOS) hay que elegirlo primero:
    // las categorías dependen de él.
    const usaReglamento = currentRulesets().length > 0;
    const reglamento = currentRuleset();
    if (usaReglamento && !reglamento) {
      catSelect.innerHTML = '<option value="">-- Primero elegí un reglamento --</option>';
      catSelect.disabled = true;
      return;
    }

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = '-- Seleccionar Categoría --';
    catSelect.appendChild(placeholder);

    (allCategories || []).forEach(c => {
      if (c.discipline !== selectedDisc) return;
      if (usaReglamento && c.ruleset !== reglamento) return;
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.setAttribute('data-discipline', c.discipline);
      opt.textContent = c.label || c.name;
      catSelect.appendChild(opt);
    });

    if (catSelect.options.length > 1) {
      catSelect.disabled = false;
    } else {
      catSelect.disabled = true;
      catSelect.innerHTML = usaReglamento
        ? '<option value="">-- No hay categorías en este reglamento --</option>'
        : '<option value="">-- No hay categorías en esta disciplina --</option>';
    }
    catSelect.value = '';
  }

  // Acopla la disciplina con el tipo de inscripción permitido y decide si el
  // desplegable de tipo se muestra (LIBRE y FREE DANCE lo ocultan).
  function filterGroupTypesByDiscipline(disc) {
    const d = normalizeDisc(disc);
    let allowed = ['Individual'];
    if (d.indexOf('DUO') > -1) allowed = ['Dúo'];
    else if (d.indexOf('TRIO') > -1) allowed = ['Trío'];
    else if (d.indexOf('CUARTETO') > -1) allowed = ['Cuarteto'];
    else if (d.indexOf('PAREJA') > -1) allowed = ['Parejas Mixtas'];
    else if (d.indexOf('SMALL') > -1) allowed = ['Small'];
    else if (d.indexOf('SHOW') > -1) allowed = ['Show'];
    else if (d.indexOf('PRECISION') > -1) allowed = ['Precisión'];

    const groupSelect = document.getElementById('group_type');
    const groupBox = document.getElementById('group_type_box');
    const labels = {
      'Individual': 'Individual (1 Patinadora)',
      'Dúo': 'Dúo (2 Patinadoras)',
      'Trío': 'Trío (3 Patinadoras)',
      'Cuarteto': 'Cuarteto (4 Patinadoras)',
      'Small': 'Small Group (Hasta 6 Patinadoras)',
      'Show': 'Show (Hasta 30 Patinadoras)',
      'Precisión': 'Precisión (Hasta 30 Patinadoras)',
      'Parejas Mixtas': 'Parejas Mixtas (2 Patinadores)'
    };

    groupSelect.innerHTML = '';
    allowed.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = labels[t] || t;
      groupSelect.appendChild(opt);
    });
    groupSelect.value = allowed[0];

    // LIBRE y FREE DANCE ocultan el tipo de inscripción (siempre individual).
    // Tampoco se muestra hasta que haya una disciplina elegida.
    const hide = !d || HIDE_TYPE_DISCIPLINES.some(x => normalizeDisc(x) === d);
    if (groupBox) groupBox.style.display = hide ? 'none' : 'block';

    updateRowVisibility();
  }

  function updateRowVisibility() {
    const type = document.getElementById('group_type').value;
    const max = MAX_BY_TYPE[type] || 1;

    const groupNameBox = document.getElementById('group_name_box');
    const helpText = document.getElementById('group_info_help');
    const mainLabel = document.getElementById('participants_label');

    if (type === 'Individual') {
      mainLabel.innerText = '2. Seleccionar Alumna *';
      helpText.style.display = 'none';
      groupNameBox.style.display = 'none';
    } else {
      mainLabel.innerText = '2. Seleccionar Alumnas del Grupo (Línea por Línea) *';
      helpText.style.display = 'block';
      groupNameBox.style.display = 'block';
    }

    buildStudentRows(max);
  }

  // El botón puede venir deshabilitado de entrada (sin alumnas o sin categorías).
  let SUBMIT_YA_BLOQUEADO = false;

  // Avisa si alguna de las patinadoras elegidas ya está anotada en esa misma
  // categoría de ESTE torneo, y bloquea el botón de confirmar.
  function checkDuplicados() {
    const box = document.getElementById('dup_warning');
    const catSelect = document.getElementById('category_id');
    const submit = document.querySelector('#enrollmentForm button[type="submit"]');
    if (!box || !catSelect || !submit) return;

    const catId = catSelect.value;
    const container = document.getElementById('student_rows');
    const elegidas = container
      ? Array.from(container.querySelectorAll('select[name="student_ids"]')).map(s => s.value).filter(Boolean)
      : [];

    const repetidas = !catId ? [] : elegidas.filter(id => YA_INSCRIPTAS.has(id + '|' + catId));

    if (!repetidas.length) {
      box.style.display = 'none';
      box.textContent = '';
      // No se reactiva el botón si ya venía deshabilitado por otro motivo
      // (sin patinadoras cargadas o sin categorías en el torneo).
      submit.disabled = SUBMIT_YA_BLOQUEADO;
      return;
    }

    const nombres = repetidas
      .map(id => STUDENTS.find(s => String(s.id) === String(id)))
      .filter(Boolean)
      .map(s => s.last_name + ' ' + s.first_name);
    const catLabel = catSelect.options[catSelect.selectedIndex]
      ? catSelect.options[catSelect.selectedIndex].textContent.trim()
      : 'esa categoría';

    box.textContent = '⚠️ ' + nombres.join(' y ') +
      (nombres.length > 1 ? ' ya están inscriptas' : ' ya está inscripta') +
      ' en ' + catLabel + ' en este torneo. No se puede repetir la misma categoría. ' +
      'Podés elegir otra categoría, o revisar las inscripciones realizadas.';
    box.style.display = 'block';
    submit.disabled = true;
  }

  function filterSelectedStudents() {
    const container = document.getElementById('student_rows');
    if (!container) return;
    const selects = Array.from(container.querySelectorAll('select[name="student_ids"]'));

    const selectedValues = selects.map(s => s.value).filter(v => v !== '');

    selects.forEach(currentSelect => {
      const currentValue = currentSelect.value;
      currentSelect.querySelectorAll('option').forEach(opt => {
        if (opt.value === '') return; // Never disable placeholder

        // Disable this option if it's selected in any other dropdown
        if (selectedValues.includes(opt.value) && opt.value !== currentValue) {
          opt.disabled = true;
        } else {
          opt.disabled = false;
        }
      });
    });
  }

  // Attach event listeners (delegación: no hace falta re-adjuntar por renglón)
  document.addEventListener('DOMContentLoaded', () => {
    const submitBtn = document.querySelector('#enrollmentForm button[type="submit"]');
    SUBMIT_YA_BLOQUEADO = !!(submitBtn && submitBtn.disabled);

    const catSelect = document.getElementById('category_id');
    if (catSelect) catSelect.addEventListener('change', checkDuplicados);

    const disciplineSelect = document.getElementById('discipline_select');
    if (disciplineSelect) {
      disciplineSelect.addEventListener('change', () => {
        populateRulesets();
        filterCategoriesByDiscipline();
        populateAgeBands();
        filterGroupTypesByDiscipline(disciplineSelect.value);
        applyStudentDefaults();
        checkDuplicados();
      });
      populateRulesets();
      populateAgeBands();
      filterGroupTypesByDiscipline(disciplineSelect.value);
    } else {
      updateRowVisibility();
    }

    // Al cambiar el reglamento se recargan las categorías de ese reglamento.
    const rulesetSelect = document.getElementById('ruleset');
    if (rulesetSelect) {
      rulesetSelect.addEventListener('change', () => {
        filterCategoriesByDiscipline();
        checkDuplicados();
      });
    }

    const ageInput = document.getElementById('age');
    if (ageInput) {
      ageInput.addEventListener('input', applyAgeBandFromAge);
    }

    const container = document.getElementById('student_rows');
    if (container) {
      container.addEventListener('change', (e) => {
        if (e.target && e.target.name === 'student_ids') {
          filterSelectedStudents();
          applyStudentDefaults();
          checkDuplicados();
        }
      });
    }
  });
</script>

