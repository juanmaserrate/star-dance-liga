<%- include('../partials/header', { title: 'Inscribir Alumna / Grupo' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper">
  <div class="card" style="max-width: 850px; margin: 0 auto;">
    <div class="card-header">
      <h1 class="card-title">✍️ Inscripción a Torneo (Individual o Grupal)</h1>
      <a href="/profesor/dashboard" class="btn btn-secondary btn-sm">&larr; Volver al Panel</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <form action="/profesor/inscribir" method="POST" id="enrollmentForm">
      
      <!-- Select Tournament -->
      <div class="form-group">
        <label class="form-label" for="tournament_select">1. Seleccionar Torneo *</label>
        <select id="tournament_select" class="form-select" onchange="window.location.href='/profesor/inscribir?tournament_id=' + this.value + '<%= preselectedStudentId ? '&student_id=' + preselectedStudentId : '' %>'" required>
          <% activeTournaments.forEach(t => { %>
            <option value="<%= t.id %>" <%= (selectedTournamentId == t.id) ? 'selected' : '' %>>
              <%= t.name %> (📅 <%= t.event_date %> - 📍 <%= t.venue %>)
            </option>
          <% }) %>
        </select>
        <input type="hidden" name="tournament_id" value="<%= selectedTournamentId %>">
      </div>

      <!-- Select Category & Discipline -->
      <div class="form-group">
        <label class="form-label" for="category_id">2. Seleccionar Disciplina y Categoría *</label>
        <% if (categories && categories.length > 0) { %>
          <select id="category_id" name="category_id" class="form-select" onchange="autoDetectDisciplineType(this)" required>
            <option value="">-- Seleccionar Categoría --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>" data-discipline="<%= c.discipline %>">
                [<%= c.discipline %>] <%= c.name %> (<%= c.min_age %>-<%= c.max_age %> años) - Arancel: $<%= c.fee %>
              </option>
            <% }) %>
          </select>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No hay categorías creadas para este torneo.</p>
        <% } %>
      </div>

      <!-- Registration Type -->
      <div class="form-group">
        <label class="form-label" for="group_type">3. Tipo de Inscripción *</label>
        <select id="group_type" name="group_type" class="form-select" onchange="updateRowVisibility()">
          <option value="Individual">Individual (1 Patinadora)</option>
          <option value="Dúo">Dúo (2 Patinadoras)</option>
          <option value="Trío">Trío (3 Patinadoras)</option>
          <option value="Cuarteto">Cuarteto (4 Patinadoras)</option>
          <option value="Small">Small Group (Hasta 6 Patinadoras)</option>
          <option value="Show">Show (Hasta 30 Patinadoras)</option>
          <option value="Precisión">Precisión (Hasta 30 Patinadoras)</option>
          <option value="Parejas Mixtas">Parejas Mixtas (2 Patinadores)</option>
        </select>
      </div>

      <!-- Select Students Line-by-Line -->
      <div class="form-group" id="student_selection_box">
        <label class="form-label" id="participants_label">4. Seleccionar Patinadora *</label>
        <small id="group_info_help" style="color: var(--gold-light); display: none; margin-bottom: 0.5rem;">
          ℹ️ En disciplinas grupales o parejas, la categoría y edad del grupo se evalúan según la participante de mayor categoría o edad.
        </small>

        <% if (students && students.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.65rem;">
            <!-- Renglón 1 (Principal) -->
            <div id="row_1" style="display: flex; gap: 0.5rem; align-items: center;">
              <span style="font-weight: 700; color: var(--gold-primary); min-width: 80px;" id="row_1_label">Patinadora:</span>
              <select name="student_ids" id="student_select_1" class="form-select" required>
                <option value="">-- Seleccionar Patinadora --</option>
                <% students.forEach(s => { %>
                  <option value="<%= s.id %>" <%= (preselectedStudentId == s.id) ? 'selected' : '' %>>
                    <%= s.last_name %>, <%= s.first_name %> (DNI: <%= s.dni %> | <%= s.age %> AÑOS | <%= s.club_name %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Renglón 2 (Dúos / Parejas / Grupos) -->
            <div id="row_2" style="display: none; gap: 0.5rem; align-items: center;">
              <span style="font-weight: 700; color: var(--gold-primary); min-width: 80px;">Renglón 2:</span>
              <select name="student_ids" id="student_select_2" class="form-select" disabled>
                <option value="">-- Seleccionar 2da Patinadora --</option>
                <% students.forEach(s => { %>
                  <option value="<%= s.id %>">
                    <%= s.last_name %>, <%= s.first_name %> (DNI: <%= s.dni %> | <%= s.age %> AÑOS | <%= s.club_name %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Renglón 3 (Tríos / Grupos) -->
            <div id="row_3" style="display: none; gap: 0.5rem; align-items: center;">
              <span style="font-weight: 700; color: var(--gold-primary); min-width: 80px;">Renglón 3:</span>
              <select name="student_ids" id="student_select_3" class="form-select" disabled>
                <option value="">-- Seleccionar 3ra Patinadora --</option>
                <% students.forEach(s => { %>
                  <option value="<%= s.id %>">
                    <%= s.last_name %>, <%= s.first_name %> (DNI: <%= s.dni %> | <%= s.age %> AÑOS | <%= s.club_name %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Renglón 4 (Cuartetos / Grupos) -->
            <div id="row_4" style="display: none; gap: 0.5rem; align-items: center;">
              <span style="font-weight: 700; color: var(--gold-primary); min-width: 80px;">Renglón 4:</span>
              <select name="student_ids" id="student_select_4" class="form-select" disabled>
                <option value="">-- Seleccionar 4ta Patinadora --</option>
                <% students.forEach(s => { %>
                  <option value="<%= s.id %>">
                    <%= s.last_name %>, <%= s.first_name %> (DNI: <%= s.dni %> | <%= s.age %> AÑOS | <%= s.club_name %>)
                  </option>
                <% }) %>
              </select>
            </div>
          </div>
        <% } else { %>
          <div class="alert alert-danger" style="margin-top: 0.5rem;">
            No tienes patinadoras en tu padrón. <a href="/profesor/alumnos/nuevo" style="color: white; text-decoration: underline">Carga una aquí primero</a>.
          </div>
        <% } %>
      </div>

      <!-- Group Fantasy Name (Hidden when Individual) -->
      <div class="form-group" id="group_name_box" style="display: none;">
        <label class="form-label" for="group_name">Nombre de Fantasía del Grupo / Pareja *</label>
        <input type="text" id="group_name" name="group_name" class="form-control" placeholder="EJ: LAS ESTRELLAS DEL SUR" style="text-transform: uppercase;">
      </div>

      <div class="form-group">
        <label class="form-label" for="notes">Notas o Comentarios de la Inscripción</label>
        <input type="text" id="notes" name="notes" class="form-control" placeholder="EJ: MÚSICA ENVIADA / PISTAS">
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="btn btn-gold" style="width: 100%; font-size: 1.1rem;" <%= (!students || students.length === 0 || !categories || categories.length === 0) ? 'disabled' : '' %>>
          ✨ Confirmar Inscripción en MAYÚSCULAS
        </button>
      </div>

    </form>
  </div>
</div>

<script>
  function autoDetectDisciplineType(selectElem) {
    const selectedOption = selectElem.options[selectElem.selectedIndex];
    if (!selectedOption) return;

    const disc = (selectedOption.getAttribute('data-discipline') || '').toUpperCase();
    const groupSelect = document.getElementById('group_type');

    if (disc.includes('DÚO')) {
      groupSelect.value = 'Dúo';
    } else if (disc.includes('TRÍO')) {
      groupSelect.value = 'Trío';
    } else if (disc.includes('CUARTETO')) {
      groupSelect.value = 'Cuarteto';
    } else if (disc.includes('PAREJA')) {
      groupSelect.value = 'Parejas Mixtas';
    } else if (disc.includes('SMALL')) {
      groupSelect.value = 'Small';
    } else if (disc.includes('SHOW')) {
      groupSelect.value = 'Show';
    } else if (disc.includes('PRECISIÓN')) {
      groupSelect.value = 'Precisión';
    } else {
      groupSelect.value = 'Individual';
    }

    updateRowVisibility();
  }

  function updateRowVisibility() {
    const type = document.getElementById('group_type').value;

    const row1 = document.getElementById('row_1');
    const row2 = document.getElementById('row_2');
    const row3 = document.getElementById('row_3');
    const row4 = document.getElementById('row_4');

    const select1 = document.getElementById('student_select_1');
    const select2 = document.getElementById('student_select_2');
    const select3 = document.getElementById('student_select_3');
    const select4 = document.getElementById('student_select_4');

    const groupNameBox = document.getElementById('group_name_box');
    const helpText = document.getElementById('group_info_help');
    const mainLabel = document.getElementById('participants_label');
    const row1Label = document.getElementById('row_1_label');

    if (type === 'Individual') {
      mainLabel.innerText = '4. Seleccionar Patinadora *';
      row1Label.innerText = 'Patinadora:';
      helpText.style.display = 'none';
      groupNameBox.style.display = 'none';

      row2.style.display = 'none';
      row3.style.display = 'none';
      row4.style.display = 'none';

      select2.disabled = true;
      select3.disabled = true;
      select4.disabled = true;
    } else {
      mainLabel.innerText = '4. Seleccionar Patinadoras del Grupo (Línea por Línea) *';
      row1Label.innerText = 'Renglón 1:';
      helpText.style.display = 'block';
      groupNameBox.style.display = 'block';

      if (type === 'Dúo' || type === 'Parejas Mixtas') {
        row2.style.display = 'flex'; select2.disabled = false;
        row3.style.display = 'none'; select3.disabled = true;
        row4.style.display = 'none'; select4.disabled = true;
      } else if (type === 'Trío') {
        row2.style.display = 'flex'; select2.disabled = false;
        row3.style.display = 'flex'; select3.disabled = false;
        row4.style.display = 'none'; select4.disabled = true;
      } else { // Cuarteto, Small, Show, Precisión
        row2.style.display = 'flex'; select2.disabled = false;
        row3.style.display = 'flex'; select3.disabled = false;
        row4.style.display = 'flex'; select4.disabled = false;
      }
    }
    
    // Trigger filtering on visibility updates
    filterSelectedStudents();
  }

  function filterSelectedStudents() {
    const selects = [
      document.getElementById('student_select_1'),
      document.getElementById('student_select_2'),
      document.getElementById('student_select_3'),
      document.getElementById('student_select_4')
    ];

    // Gather currently selected values (excluding empty placeholder)
    const selectedValues = selects
      .filter(s => s && !s.disabled)
      .map(s => s.value)
      .filter(val => val !== '');

    selects.forEach(currentSelect => {
      if (!currentSelect || currentSelect.disabled) return;

      const currentValue = currentSelect.value;
      const options = currentSelect.querySelectorAll('option');

      options.forEach(opt => {
        if (opt.value === '') return; // Never disable placeholder

        // Disable this option if it's selected in any other dropdown
        if (selectedValues.includes(opt.value) && opt.value !== currentValue) {
          opt.disabled = true;
        } else {
          opt.disabled = false;
        }
      });
    });
  }

  // Attach event listeners to all student dropdowns
  document.addEventListener('DOMContentLoaded', () => {
    updateRowVisibility();
    
    const selects = [
      document.getElementById('student_select_1'),
      document.getElementById('student_select_2'),
      document.getElementById('student_select_3'),
      document.getElementById('student_select_4')
    ];

    selects.forEach(s => {
      if (s) {
        s.addEventListener('change', filterSelectedStudents);
      }
    });
  });
</script>

<%- include('../partials/footer') %>
