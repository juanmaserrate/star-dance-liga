<%- include('../partials/header', { title: 'Mis Alumnas' }) %>
<%- include('profesor_shell', { activeNav: 'mis_alumnas', topbarSection: 'Mis Alumnas', selectedClubId }) %>


  <div class="page-head-row">
    <div class="page-head">
      <h1 class="page-title">Mis Alumnas</h1>
      <% if (selectedClubId && myClubs && myClubs.length > 0) { %>
        <% const clubFiltro = myClubs.find(c => c.id == selectedClubId); %>
        <% if (clubFiltro) { %>
          <p class="page-sub">Mostrando el padrón del club <strong style="color: var(--gold-light);"><%= clubFiltro.name %></strong>. Elegí otro club en el desplegable de arriba.</p>
        <% } %>
      <% } %>
    </div>
    <div class="page-head-actions">
      <a href="/profesor/alumnos/nuevo" class="btn btn-gold">+ Cargar Alumna</a>
      <a href="/profesor/inscribir" class="btn btn-outline-gold">✍️ Inscribir a Torneo</a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <!-- Padrón con edición masiva -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h2 class="card-title">👥 Padrón de Alumnas (<%= students.length %>)</h2>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/profesor/alumnos/nuevo" class="btn btn-gold btn-sm">+ Cargar Alumna</a>
      </div>
    </div>

    <% if (students && students.length > 0) { %>
      <form action="/profesor/alumnos/masiva" method="POST" id="bulkEditForm" style="margin-bottom: 1rem;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; background: rgba(18,6,28,0.6); border: 1px solid rgba(212,175,55,0.2); border-radius: var(--radius-sm); padding: 0.85rem;">
          <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
            <label class="form-label" for="bulk_field">Edición masiva: campo a modificar</label>
            <select id="bulk_field" name="field" class="form-select">
              <option value="category_default">Categoría</option>
              <option value="club_id">Club</option>
              <option value="health_insurance">Obra Social / Seguro</option>
              <option value="policy_number">N° Póliza</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0; min-width: 200px; flex: 1;">
            <label class="form-label" for="bulk_value">Nuevo valor (en MAYÚSCULAS)</label>
            <input type="text" id="bulk_value" name="value" class="form-control" style="text-transform: uppercase;" placeholder="EJ: OSDE 310">
          </div>
          <button type="submit" class="btn btn-gold" onclick="return confirm('¿Aplicar este cambio a las patinadoras seleccionadas?');">Aplicar a seleccionadas</button>
          <button type="submit" formaction="/profesor/alumnos/eliminar" class="btn btn-danger" onclick="return confirm('¿Eliminar las patinadoras seleccionadas?\nSe borran también sus inscripciones y documentos.');">🗑️ Eliminar seleccionadas</button>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th style="width: 36px;"><input type="checkbox" id="selectAll" title="Seleccionar todas"></th>
                <th>Nombre y Apellido</th>
                <th>DNI</th>
                <th>Categoría</th>
                <th>Edad</th>
                <th>Fecha Nacimiento</th>
                <th>Club</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td><input type="checkbox" name="student_ids" value="<%= s.id %>" class="row-check"></td>
                  <td><strong><%= s.last_name %>, <%= s.first_name %></strong></td>
                  <td><strong style="color: var(--gold-light);"><%= s.dni %></strong></td>
                  <td><%= s.category_default ? formatCategoryName(s.category_default) : '-' %></td>
                  <td><span class="badge badge-violet"><%= s.age %> AÑOS</span></td>
                  <td><%= s.birth_date %></td>
                  <td><strong><%= s.club_name %></strong></td>
                  <td>
                    <div style="display: flex; gap: 0.4rem;">
                      <a href="/profesor/alumnos/<%= s.id %>/ver" class="btn btn-outline-gold btn-sm" title="Ver ficha técnica completa">🔍 Ver</a>
                      <a href="/profesor/alumnos/<%= s.id %>/editar" class="btn btn-secondary btn-sm" title="Editar datos">✏️ Editar</a>
                      <a href="/profesor/inscribir?student_id=<%= s.id %>" class="btn btn-gold btn-sm" title="Inscribir a torneo">✍️ Inscribir</a>
                      <button type="submit" formaction="/profesor/alumnos/<%= s.id %>/eliminar" class="btn btn-danger btn-sm" title="Eliminar patinadora" onclick="return confirm('¿Eliminar a <%= s.last_name %>, <%= s.first_name %>?\nSe borran también sus inscripciones y documentos.');">🗑️ Eliminar</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </form>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2.5rem;">
        Aún no has registrado patinadoras en tu padrón.<br>
        <a href="/profesor/alumnos/nuevo" class="btn btn-gold" style="margin-top: 1rem;">+ Cargar Primera Alumna</a>
      </p>
    <% } %>
  </div>

  <!-- Inscripciones -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">📜 Mis Inscripciones en Torneos</h2>
      <a href="/profesor/inscribir" class="btn btn-gold btn-sm">+ Nueva Inscripción</a>
    </div>

    <% if (myRegistrations && myRegistrations.length > 0) { %>
    <!-- Buscador y filtros por columna. Trabajan sobre las filas ya cargadas,
         así que el resultado es instantáneo y no recarga la página. -->
    <div id="inscFiltros" style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-gold);">
      <div style="position: relative; margin-bottom: 0.75rem;">
        <span style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--gold-light); font-size: 1.1rem;">🔍</span>
        <input type="search" id="fBuscar" class="form-control" style="padding-left: 2.4rem;"
               placeholder="Buscar en todo: alumna, DNI, club, torneo, categoría, grupo…"
               autocomplete="off">
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.6rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fTorneo">Torneo</label>
          <select id="fTorneo" class="form-select" data-campo="torneo"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fDisciplina">Disciplina</label>
          <select id="fDisciplina" class="form-select" data-campo="disciplina"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fCategoria">Categoría</label>
          <select id="fCategoria" class="form-select" data-campo="categoria"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fBanda">Categoría de Edad</label>
          <select id="fBanda" class="form-select" data-campo="banda"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fEdad">Edad</label>
          <select id="fEdad" class="form-select" data-campo="edad"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fTipo">Tipo</label>
          <select id="fTipo" class="form-select" data-campo="tipo"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="fClub">Club</label>
          <select id="fClub" class="form-select" data-campo="club"></select>
        </div>
        <div class="form-group" style="margin-bottom: 0; display: flex; align-items: flex-end;">
          <button type="button" id="fLimpiar" class="btn btn-secondary btn-sm" style="width: 100%; height: 40px;">Limpiar filtros</button>
        </div>
      </div>

      <div style="margin-top: 0.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <span id="fContador" class="count-chip"></span>
        <span id="fSinResultados" style="display: none; color: var(--gold-light); font-size: 0.88rem;">
          Ninguna inscripción coincide con lo que buscás.
        </span>
      </div>
    </div>

      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Alumna</th>
              <th>Disciplina</th>
              <th>Categoría</th>
              <th>Edad</th>
              <th>Categoría de Edad</th>
              <th>Tipo</th>
              <th>Club</th>
              <th>Torneo</th>
              <th>Certificado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="registrationsBody">
            <% myRegistrations.forEach(r => { %>
              <%
                const catCorta = formatCategoryName(r.category_name, r.discipline);
                const alumna = r.is_group && r.group_name
                  ? r.group_name
                  : ((r.last_name || '') + ' ' + (r.first_name || '')).trim();
                const buscable = [
                  alumna, r.dni, r.discipline, catCorta, r.age_band, r.club_name,
                  r.tournament_name, r.group_type, r.group_name, r.level,
                  r.age ? r.age + ' años' : ''
                ].filter(Boolean).join(' ').toLowerCase();
              %>
              <tr
                data-torneo="<%= r.tournament_name || '' %>"
                data-disciplina="<%= r.discipline || '' %>"
                data-categoria="<%= catCorta || '' %>"
                data-banda="<%= r.age_band || '' %>"
                data-edad="<%= r.age || '' %>"
                data-tipo="<%= r.group_type || 'Individual' %>"
                data-club="<%= r.club_name || '' %>"
                data-buscar="<%= buscable %>">
                <td>
                  <strong><%= r.last_name %>, <%= r.first_name %></strong>
                  <div style="font-size: 0.78rem; color: var(--text-muted);">
                    DNI: <%= r.dni %><%= r.club_name ? ' · ' + r.club_name : '' %>
                    <% if (r.is_group) { %>
                      · <%= r.member_count > 1 ? ('Grupo (' + (r.member_index + 1) + '/' + r.member_count + ')') : 'Grupo' %><%= r.group_name ? ' — ' + r.group_name : '' %>
                    <% } %>
                  </div>
                </td>
                <td><span class="badge"><%= r.discipline %></span></td>
                <td>
                  <span class="badge badge-violet"><%= formatCategoryName(r.category_name, r.discipline) %></span>
                  <div style="font-size: 0.78rem; color: var(--text-muted);"><%= r.level || 'Nivel' %></div>
                </td>
                <td><%= r.age ? r.age + ' años' : '-' %></td>
                <td>
                  <% if (r.age_band) { %>
                    <span class="badge"><%= r.age_band %></span>
                    <% if (r.bandRange) { %>
                      <div style="font-size: 0.78rem; color: var(--text-muted);"><%= r.bandRange %> años</div>
                    <% } %>
                  <% } else { %>
                    <span style="color: var(--text-muted);">-</span>
                  <% } %>
                </td>
                <td><%= r.group_type || 'Individual' %></td>
                <td><%= r.club_name %></td>
                <td><%= r.tournament_name %><div style="font-size: 0.78rem; color: var(--text-muted);"><%= r.datesLabel %></div></td>
                <td>
                  <a href="/profesor/certificado/<%= r.id %>" target="_blank" class="btn btn-outline-gold btn-sm">🖨️ Certificado</a>
                </td>
                <td>
                  <div style="display: flex; gap: 0.3rem;">
                      <a href="/profesor/inscripciones/<%= r.id %>/editar" class="btn btn-outline-gold btn-sm" title="Editar o mover de torneo">✏️ Editar</a>
                      <form action="/profesor/inscripciones/<%= r.id %>/eliminar" method="POST" style="margin: 0;">
                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar la inscripción"
                          onclick="return confirm('¿Eliminar esta inscripción?\n\nLa patinadora deja de estar anotada en esa categoría. Queda una copia guardada por si hubo un error.');">🗑️</button>
                      </form>
                    </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">
        No has inscripto alumnas en torneos aún.<br>
        <a href="/profesor/inscribir" class="btn btn-gold btn-sm" style="margin-top: 0.75rem;">Ir a Inscripción</a>
      </p>
    <% } %>
  </div>
</div>

<script>
  // --- Buscador y filtros de "Mis Inscripciones en Torneos" -----------------
  // Filtra sobre las filas ya renderizadas. Cada desplegable ofrece solo los
  // valores que siguen siendo posibles con los OTROS filtros puestos, así no se
  // llega nunca a una combinación sin resultados.
  (function () {
    const cuerpo = document.getElementById('registrationsBody');
    const barra = document.getElementById('inscFiltros');
    if (!cuerpo || !barra) return;

    const filas = Array.from(cuerpo.querySelectorAll('tr'));
    const selects = Array.from(barra.querySelectorAll('select[data-campo]'));
    const buscador = document.getElementById('fBuscar');
    const contador = document.getElementById('fContador');
    const vacio = document.getElementById('fSinResultados');

    const ETIQUETAS = {
      torneo: 'los torneos', disciplina: 'las disciplinas', categoria: 'las categorías',
      banda: 'las categorías de edad', edad: 'las edades', tipo: 'los tipos', club: 'los clubes'
    };

    const valorDe = (fila, campo) => fila.dataset[campo] || '';

    // ¿La fila pasa los filtros, ignorando el campo indicado?
    function pasa(fila, exceptuar) {
      const texto = (buscador.value || '').trim().toLowerCase();
      if (texto && !(fila.dataset.buscar || '').includes(texto)) return false;
      return selects.every(sel => {
        const campo = sel.dataset.campo;
        if (campo === exceptuar || !sel.value) return true;
        return valorDe(fila, campo) === sel.value;
      });
    }

    function poblar() {
      selects.forEach(sel => {
        const campo = sel.dataset.campo;
        const elegido = sel.value;

        const posibles = [...new Set(
          filas.filter(f => pasa(f, campo)).map(f => valorDe(f, campo)).filter(Boolean)
        )].sort((a, b) => {
          const na = Number(a), nb = Number(b);
          if (Number.isFinite(na) && Number.isFinite(nb)) return na - nb;
          return a.localeCompare(b, 'es');
        });

        // Si lo elegido ya no está entre los posibles, igual se conserva como
        // opción para que el usuario vea qué tiene puesto y pueda sacarlo.
        if (elegido && !posibles.includes(elegido)) posibles.unshift(elegido);

        sel.innerHTML = '';
        const todas = document.createElement('option');
        todas.value = '';
        todas.textContent = 'Todas / todos';
        sel.appendChild(todas);

        posibles.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = campo === 'edad' ? v + ' años' : v;
          sel.appendChild(opt);
        });

        sel.value = elegido;
        sel.title = elegido ? elegido : 'Sin filtrar por ' + (ETIQUETAS[campo] || campo);
      });
    }

    function aplicar() {
      let visibles = 0;
      filas.forEach(fila => {
        const ok = pasa(fila, null);
        fila.style.display = ok ? '' : 'none';
        if (ok) visibles++;
      });

      contador.textContent = visibles === filas.length
        ? filas.length + (filas.length === 1 ? ' inscripción' : ' inscripciones')
        : 'Mostrando ' + visibles + ' de ' + filas.length;
      vacio.style.display = visibles === 0 ? 'inline' : 'none';

      poblar();
    }

    selects.forEach(sel => sel.addEventListener('change', aplicar));
    buscador.addEventListener('input', aplicar);

    document.getElementById('fLimpiar').addEventListener('click', () => {
      buscador.value = '';
      selects.forEach(sel => { sel.value = ''; });
      aplicar();
    });

    aplicar();
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
      selectAll.addEventListener('change', () => {
        document.querySelectorAll('.row-check').forEach(cb => { cb.checked = selectAll.checked; });
      });
    }
  });
</script>

<%- include('../partials/footer') %>
