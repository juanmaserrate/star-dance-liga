<%- include('../partials/header', { title: 'Mis Alumnas' }) %>
<%- include('profesor_shell', { activeNav: 'mis_alumnas', topbarSection: 'Mis Alumnas', selectedClubId }) %>


  <div class="page-head-row">
    <div class="page-head">
      <h1 class="page-title">Mis Alumnas</h1>
      <% if (selectedClubId && myClubs && myClubs.length > 0) { %>
        <% const clubFiltro = myClubs.find(c => c.id == selectedClubId); %>
        <% if (clubFiltro) { %>
          <p class="page-sub">Mostrando el padrón del club <strong style="color: var(--gold-light);"><%= clubFiltro.name %></strong>. Elegí otro club en el desplegable de arriba.</p>
        <% } %>
      <% } %>
    </div>
    <div class="page-head-actions">
      <a href="/profesor/alumnos/nuevo" class="btn btn-gold">+ Cargar Alumna</a>
      <a href="/profesor/inscribir" class="btn btn-outline-gold">✍️ Inscribir a Torneo</a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <!-- Padrón con edición masiva -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h2 class="card-title">👥 Padrón de Alumnas (<%= students.length %>)</h2>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/profesor/alumnos/nuevo" class="btn btn-gold btn-sm">+ Cargar Alumna</a>
      </div>
    </div>

    <% if (students && students.length > 0) { %>
      <form action="/profesor/alumnos/masiva" method="POST" id="bulkEditForm" style="margin-bottom: 1rem;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; background: rgba(18,6,28,0.6); border: 1px solid rgba(212,175,55,0.2); border-radius: var(--radius-sm); padding: 0.85rem;">
          <div class="form-group" style="margin-bottom: 0; min-width: 200px;">
            <label class="form-label" for="bulk_field">Edición masiva: campo a modificar</label>
            <select id="bulk_field" name="field" class="form-select">
              <option value="category_default">Categoría</option>
              <option value="club_id">Club</option>
              <option value="health_insurance">Obra Social / Seguro</option>
              <option value="policy_number">N° Póliza</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0; min-width: 200px; flex: 1;">
            <label class="form-label" for="bulk_value">Nuevo valor (en MAYÚSCULAS)</label>
            <input type="text" id="bulk_value" name="value" class="form-control" style="text-transform: uppercase;" placeholder="EJ: OSDE 310">
          </div>
          <button type="submit" class="btn btn-gold" onclick="return confirm('¿Aplicar este cambio a las patinadoras seleccionadas?');">Aplicar a seleccionadas</button>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th style="width: 36px;"><input type="checkbox" id="selectAll" title="Seleccionar todas"></th>
                <th>Nombre y Apellido</th>
                <th>DNI</th>
                <th>Categoría</th>
                <th>Edad</th>
                <th>Fecha Nacimiento</th>
                <th>Club</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td><input type="checkbox" name="student_ids" value="<%= s.id %>" class="row-check"></td>
                  <td><strong><%= s.last_name %>, <%= s.first_name %></strong></td>
                  <td><strong style="color: var(--gold-light);"><%= s.dni %></strong></td>
                  <td><%= s.category_default ? formatCategoryName(s.category_default) : '-' %></td>
                  <td><span class="badge badge-violet"><%= s.age %> AÑOS</span></td>
                  <td><%= s.birth_date %></td>
                  <td><strong><%= s.club_name %></strong></td>
                  <td>
                    <div style="display: flex; gap: 0.4rem;">
                      <a href="/profesor/alumnos/<%= s.id %>/ver" class="btn btn-outline-gold btn-sm" title="Ver ficha técnica completa">🔍 Ver</a>
                      <a href="/profesor/alumnos/<%= s.id %>/editar" class="btn btn-secondary btn-sm" title="Editar datos">✏️ Editar</a>
                      <a href="/profesor/inscribir?student_id=<%= s.id %>" class="btn btn-gold btn-sm" title="Inscribir a torneo">✍️ Inscribir</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </form>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2.5rem;">
        Aún no has registrado patinadoras en tu padrón.<br>
        <a href="/profesor/alumnos/nuevo" class="btn btn-gold" style="margin-top: 1rem;">+ Cargar Primera Alumna</a>
      </p>
    <% } %>
  </div>

  <!-- Inscripciones -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">📜 Mis Inscripciones en Torneos</h2>
      <a href="/profesor/inscribir" class="btn btn-gold btn-sm">+ Nueva Inscripción</a>
    </div>

    <% if (myRegistrations && myRegistrations.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Alumna</th>
              <th>Disciplina</th>
              <th>Edad</th>
              <th>Categoría</th>
              <th>Torneo</th>
              <th>Fecha Evento</th>
              <th>Certificado</th>
            </tr>
          </thead>
          <tbody id="registrationsBody">
            <% myRegistrations.forEach(r => { %>
              <tr>
                <td>
                  <strong><%= r.last_name %>, <%= r.first_name %></strong>
                  <% if (r.is_group) { %>
                    <div style="font-size: 0.78rem; color: var(--gold-light);">
                      <%= r.member_count > 1 ? ('Grupo (' + (r.member_index + 1) + '/' + r.member_count + ')') : 'Grupo' %>
                      <%= r.group_name ? '— ' + r.group_name : '' %>
                    </div>
                  <% } %>
                </td>
                <td><span class="badge"><%= r.discipline %></span></td>
                <td><%= r.age %> años<%= r.age_band ? ' · ' + r.age_band : '' %></td>
                <td>
                  <span class="badge badge-violet"><%= formatCategoryName(r.category_name, r.discipline) %></span>
                  <div style="font-size: 0.78rem; color: var(--text-muted);"><%= r.level || 'Nivel' %></div>
                </td>
                <td><%= r.tournament_name %></td>
                <td><%= r.datesLabel %></td>
                <td>
                  <a href="/profesor/certificado/<%= r.id %>" target="_blank" class="btn btn-outline-gold btn-sm">🖨️ Certificado</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">
        No has inscripto alumnas en torneos aún.<br>
        <a href="/profesor/inscribir" class="btn btn-gold btn-sm" style="margin-top: 0.75rem;">Ir a Inscripción</a>
      </p>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
      selectAll.addEventListener('change', () => {
        document.querySelectorAll('.row-check').forEach(cb => { cb.checked = selectAll.checked; });
      });
    }
  });
</script>

<%- include('../partials/footer') %>
