<%- include('../partials/header', { title: 'Gestión de Usuarios' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper">
  <div style="margin-bottom: 1.5rem;">
    <h1 style="color: var(--gold-light); font-size: 1.8rem;">Cuentas de Usuarios y Roles</h1>
    <p style="color: var(--text-muted);">Alta y gestión de accesos para Profesores, Jueces y Administradores de la liga.</p>
  </div>

  <%- include('admin_nav') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    <!-- Create User Form -->
    <div class="card" style="margin: 0;">
      <h2 class="card-title" style="margin-bottom: 1rem;">👤 Crear Nuevo Usuario</h2>
      
      <form action="/admin/usuarios" method="POST">
        <div class="form-group">
          <label class="form-label" for="full_name">Nombre y Apellido *</label>
          <input type="text" id="full_name" name="full_name" class="form-control" placeholder="Ej: Ana Clara Gómez" required>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="username">Usuario (Login) *</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Ej: profe.ana" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Contraseña *</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="role">Rol en la Plataforma *</label>
            <select id="role" name="role" class="form-select" required>
              <option value="profesor">Profesor/a (Carga de alumnos e inscripción)</option>
              <option value="juez">Juez (Módulo de jurado y planilla)</option>
              <option value="admin">Administrador (Acceso total)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="club_id">Club Perteneciente</label>
            <select id="club_id" name="club_id" class="form-select">
              <option value="">-- Sin Club (Independiente / Juez) --</option>
              <% clubs.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="correo@ejemplo.com">
          </div>

          <div class="form-group">
            <label class="form-label" for="phone">Teléfono</label>
            <input type="text" id="phone" name="phone" class="form-control" placeholder="+54 9 ...">
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 0.5rem;">
          ✨ Crear Cuenta
        </button>
      </form>
    </div>

    <!-- Users Table -->
    <div class="card" style="margin: 0;">
      <h2 class="card-title" style="margin-bottom: 1rem;">📋 Usuarios Activos (<%= usersList.length %>)</h2>

      <% if (usersList && usersList.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Usuario</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th>Club</th>
              </tr>
            </thead>
            <tbody>
              <% usersList.forEach(u => { %>
                <tr>
                  <td><strong><%= u.username %></strong></td>
                  <td><%= u.full_name %></td>
                  <td>
                    <span class="badge <%= u.role === 'admin' ? 'badge-paid' : (u.role === 'juez' ? 'badge-pending' : 'badge-violet') %>">
                      <%= u.role.toUpperCase() %>
                    </span>
                  </td>
                  <td><%= u.club_name || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% else { %>
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No hay usuarios creados.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
