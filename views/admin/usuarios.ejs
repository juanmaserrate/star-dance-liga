<%- include('../partials/header', { title: 'Gestión de Usuarios' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper">
  <div style="margin-bottom: 1.5rem;">
    <h1 style="color: var(--gold-light); font-size: 1.8rem;">👥 Gestión de Usuarios y Accesos</h1>
    <p style="color: var(--text-muted);">Administración de profesores, jueces y administradores con generador de recuperación de contraseña.</p>
  </div>

  <%- include('admin_nav') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success" style="word-break: break-all;">✅ <%= success %></div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    <!-- Create User Form -->
    <div class="card" style="margin: 0;">
      <h2 class="card-title" style="margin-bottom: 1rem;">➕ Registrar Nuevo Usuario</h2>

      <form action="/admin/usuarios" method="POST">
        <div class="form-group">
          <label class="form-label" for="full_name">Nombre Completo *</label>
          <input type="text" id="full_name" name="full_name" class="form-control" placeholder="EJ: ANA MARTÍNEZ" required style="text-transform: uppercase;">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="username">Usuario (Login) *</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="profe.ana" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Contraseña *</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Email (Para Recuperación)</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="ana@estrellapatin.com">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="role">Rol en el Sistema *</label>
            <select id="role" name="role" class="form-select" required>
              <option value="profesor">Profesor/a</option>
              <option value="juez">Juez / Evaluador</option>
              <option value="admin">Administrador</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="club_id">Club Principal</label>
            <select id="club_id" name="club_id" class="form-select">
              <option value="">-- Sin Club --</option>
              <% clubs.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 0.5rem;">
          💾 Crear Usuario
        </button>
      </form>
    </div>

    <!-- Users List -->
    <div class="card" style="margin: 0;">
      <h2 class="card-title" style="margin-bottom: 1rem;">📋 Usuarios Registrados (<%= usersList.length %>)</h2>

      <% if (usersList && usersList.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Club / Email</th>
                <th>Recuperación</th>
              </tr>
            </thead>
            <tbody>
              <% usersList.forEach(u => { %>
                <tr>
                  <td>
                    <strong><%= u.full_name %></strong><br>
                    <small style="color: var(--text-muted);">@<%= u.username %></small>
                  </td>
                  <td>
                    <span class="badge <%= u.role === 'admin' ? 'badge-paid' : (u.role === 'juez' ? 'badge-violet' : 'badge-pending') %>">
                      <%= u.role.toUpperCase() %>
                    </span>
                  </td>
                  <td>
                    <%= u.club_name || '-' %><br>
                    <small style="color: var(--gold-light);"><%= u.email || 'Sin mail' %></small>
                  </td>
                  <td>
                    <form action="/admin/usuarios/<%= u.id %>/restablecer" method="POST">
                      <button type="submit" class="btn btn-outline-gold btn-sm" title="Generar link para enviar por WhatsApp o Email">
                        🔑 Generar Link
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
