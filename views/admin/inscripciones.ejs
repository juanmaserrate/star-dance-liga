<%- include('../partials/header', { title: 'Gestión de Inscripciones y Pagos' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
    <div>
      <h1 style="color: var(--gold-light); font-size: 1.8rem;">Master de Inscripciones, Bonificaciones y Control de Pagos</h1>
      <p style="color: var(--text-muted);">Visualizador general con desglose en columnas individuales para cada dato.</p>
    </div>
    
    <a href="/admin/exportar/csv?<%= selectedTournament ? 'tournament_id=' + selectedTournament + '&' : '' %><%= selectedClub ? 'club_id=' + selectedClub + '&' : '' %><%= selectedPayment ? 'payment_status=' + selectedPayment : '' %>" class="btn btn-gold">
      📥 Exportar a Excel / CSV (MAYÚSCULAS)
    </a>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>

  <!-- Filter Bar -->
  <div class="card" style="padding: 1.25rem; margin-bottom: 1.5rem;">
    <form action="/admin/inscripciones" method="GET" class="form-row" style="align-items: flex-end;">
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filtrar por Torneo</label>
        <select name="tournament_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Todos los Torneos --</option>
          <% tournaments.forEach(t => { %>
            <option value="<%= t.id %>" <%= selectedTournament == t.id ? 'selected' : '' %>><%= t.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Filtrar por Club</label>
        <select name="club_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Todos los Clubes --</option>
          <% clubs.forEach(c => { %>
            <option value="<%= c.id %>" <%= selectedClub == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Estado de Pago</label>
        <select name="payment_status" class="form-select" onchange="this.form.submit()">
          <option value="">-- Todos los Estados --</option>
          <option value="paid" <%= selectedPayment === 'paid' ? 'selected' : '' %>>Solo Pagados</option>
          <option value="pending" <%= selectedPayment === 'pending' ? 'selected' : '' %>>Solo Pendientes</option>
        </select>
      </div>

      <div>
        <a href="/admin/inscripciones" class="btn btn-secondary btn-sm" style="height: 40px; display: flex; align-items: center;">Limpiar Filtros</a>
      </div>
    </form>
  </div>

  <!-- Registrations Table with Every Field in a Separate Column -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">📋 Patinadoras e Inscripciones (<%= registrations.length %>)</h2>
    </div>

    <% if (registrations && registrations.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>DNI</th>
              <th>CUIL</th>
              <th>Fecha Nac.</th>
              <th>Edad</th>
              <th>Club</th>
              <th>Profesora</th>
              <th>Categoría</th>
              <th>Disciplina</th>
              <th>Arancel Base</th>
              <th>Bonificación</th>
              <th>Arancel Final</th>
              <th>Docs</th>
              <th>Estado Pago</th>
              <th>Acción Admin</th>
            </tr>
          </thead>
          <tbody>
            <% registrations.forEach(r => { %>
              <tr>
                <td>
                  <strong><%= r.first_name %></strong>
                  <% if (r.is_group) { %>
                    <div style="font-size: 0.75rem; color: var(--gold-light);"><%= r.group_type %>: <%= r.group_name %></div>
                  <% } %>
                </td>
                <td><strong><%= r.last_name %></strong></td>
                <td><strong style="color: var(--gold-light);"><%= r.dni %></strong></td>
                <td><%= r.cuil || '-' %></td>
                <td><%= r.birth_date || '-' %></td>
                <td><span class="badge badge-violet"><%= r.age || 0 %> AÑOS</span></td>
                <td><strong><%= r.club_name %></strong></td>
                <td><span style="color: var(--gold-primary); font-size: 0.85rem;"><%= r.teacher_name %></span></td>
                <td><span class="badge badge-violet"><%= r.category_name %></span></td>
                <td><%= r.discipline %></td>
                <td>$<%= r.original_fee %></td>
                <td>
                  <% if (r.discount_amount > 0) { %>
                    <span class="badge badge-paid">-$<%= r.discount_amount %></span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td style="font-weight: 800; color: var(--gold-light);">$<%= r.final_fee %></td>
                <td>
                  <% if (r.doc_count > 0) { %>
                    <a href="/admin/alumnos/<%= r.student_id %>/documentos" class="btn btn-outline-gold btn-sm">📄 Docs (<%= r.doc_count %>)</a>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td>
                  <% if (r.payment_status === 'paid') { %>
                    <span class="badge badge-paid">✅ PAGADO</span>
                  <% } else { %>
                    <span class="badge badge-pending">⏳ PENDIENTE</span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                    <form action="/admin/inscripciones/<%= r.id %>/pago" method="POST">
                      <button type="submit" class="btn <%= r.payment_status === 'paid' ? 'btn-secondary' : 'btn-gold' %> btn-sm" style="width: 100%;">
                        <%= r.payment_status === 'paid' ? 'Pendiente' : 'Pagado' %>
                      </button>
                    </form>

                    <button class="btn btn-outline-gold btn-sm" onclick="document.getElementById('discount_box_<%= r.id %>').style.display='block'">
                      🎁 Beca
                    </button>
                  </div>

                  <!-- Mini discount box -->
                  <div id="discount_box_<%= r.id %>" style="display: none; background: rgba(18,6,28,0.95); border: 1px solid var(--gold-primary); padding: 0.75rem; border-radius: var(--radius-sm); position: absolute; z-index: 100; right: 2rem; width: 260px;">
                    <strong style="color: var(--gold-light); font-size: 0.85rem;">Aplicar Bonificación / Beca:</strong>
                    <form action="/admin/inscripciones/<%= r.id %>/descuento" method="POST" style="margin-top: 0.5rem;">
                      <input type="number" name="discount_amount" class="form-control" placeholder="Monto Descuento $" value="<%= r.discount_amount %>" style="margin-bottom: 0.4rem;" required>
                      <input type="text" name="discount_reason" class="form-control" placeholder="Motivo (Ej: BECA PROFE)" value="<%= r.discount_reason || '' %>" style="margin-bottom: 0.4rem; text-transform: uppercase;" required>
                      <div style="display: flex; gap: 0.4rem;">
                        <button type="submit" class="btn btn-gold btn-sm" style="flex: 1;">Guardar</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('discount_box_<%= r.id %>').style.display='none'">X</button>
                      </div>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2.5rem;">No se encontraron inscripciones con los filtros seleccionados.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
