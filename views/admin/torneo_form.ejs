<% const editing = (typeof isEdit !== 'undefined' && isEdit); %>
<%- include('../partials/header', { title: editing ? 'Editar Torneo' : 'Nuevo Torneo' }) %>
<%- include('admin_shell', { activeNav: 'torneos', topbarSection: 'Torneos' }) %>


  <div class="card" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header">
      <h1 class="card-title"><%= editing ? '✏️ Editar Torneo' : '🏆 Crear Nuevo Torneo' %></h1>
      <a href="/admin/torneos" class="btn btn-secondary btn-sm">&larr; Volver</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <% if (editing) { %>
      <div class="alert alert-success" style="margin-bottom: 1.25rem;">
        ℹ️ Los cambios (incluido el nombre) se reflejan automáticamente en el formulario de inscripción y en todas las inscripciones ya realizadas.
      </div>
    <% } %>

    <form action="<%= editing ? '/admin/torneos/' + tournament.id + '/editar' : '/admin/torneos/nuevo' %>" method="POST">
      <div class="form-group">
        <label class="form-label" for="name">Nombre del Torneo *</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="Ej: Torneo Apertura 2026 - Liga Star Dance" value="<%= tournament ? tournament.name : '' %>" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Descripción / Presentación</label>
        <textarea id="description" name="description" class="form-control" rows="3" placeholder="Información del evento..."><%= tournament ? tournament.description : '' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="venue">Sede / Polideportivo / Lugar *</label>
        <input type="text" id="venue" name="venue" class="form-control" placeholder="Ej: Argentinos Juniors" value="<%= tournament ? tournament.venue : '' %>" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="date_from">Fecha de Inicio *</label>
          <input type="date" id="date_from" name="date_from" class="form-control" value="<%= tournament ? (tournament.date_from || tournament.event_date) : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="date_to">Fecha de Fin <small>(si son varias fechas)</small></label>
          <input type="date" id="date_to" name="date_to" class="form-control" value="<%= tournament ? tournament.date_to : '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="registration_deadline">Cierre de Inscripciones *</label>
          <input type="date" id="registration_deadline" name="registration_deadline" class="form-control" value="<%= tournament ? tournament.registration_deadline : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="status">Estado del Torneo</label>
          <select id="status" name="status" class="form-select">
            <option value="upcoming" <%= tournament && tournament.status === 'upcoming' ? 'selected' : '' %>>Próximo (Inscripciones Abiertas)</option>
            <option value="active" <%= tournament && tournament.status === 'active' ? 'selected' : '' %>>En Curso</option>
            <option value="finished" <%= tournament && tournament.status === 'finished' ? 'selected' : '' %>>Finalizado</option>
          </select>
        </div>
      </div>
      <input type="hidden" id="event_date" name="event_date" value="<%= tournament ? (tournament.date_from || tournament.event_date) : '' %>">

      <div style="margin-top: 2rem; display: flex; gap: 0.6rem; flex-wrap: wrap;">
        <button type="submit" class="btn btn-gold" style="flex: 1; min-width: 240px;">
          <%= editing ? '💾 Guardar Cambios' : '✨ Crear Torneo y Continuar a Categorías →' %>
        </button>
        <% if (editing) { %>
          <a href="/admin/torneos/<%= tournament.id %>/categorias" class="btn btn-outline-gold">⚙️ Configurar Disciplinas y Categorías</a>
        <% } %>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
