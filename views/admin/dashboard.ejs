<%- include('../partials/header', { title: 'Dashboard Status Administrador' }) %>
<%- include('admin_shell', { activeNav: 'dashboard', topbarSection: 'Dashboard' }) %>

  <div class="page-head-row">
    <div class="page-head">
      <span class="page-eyebrow">Módulo Administrador</span>
      <h1 class="page-title">Panel de Control — Star Dance</h1>
      <% if (selectedTournament) { %>
        <p class="page-sub">Mostrando solo los datos de <strong style="color: var(--gold-light);"><%= selectedTournament.name %></strong> (<%= selectedTournament.datesLabel %> · <%= selectedTournament.venue %>).</p>
      <% } else { %>
        <p class="page-sub">Control general de estadísticas y padrón maestro de deportistas cargadas.</p>
      <% } %>
    </div>
    <div class="page-head-actions">
      <a href="/admin/alumnos/nuevo" class="btn btn-gold">+ Nueva Patinadora</a>
      <a href="/admin/torneos/nuevo" class="btn btn-ghost">+ Nuevo Torneo</a>
    </div>
  </div>

  <!-- Filtro por torneo -->
  <div class="admin-card" style="margin-bottom: 1.5rem;">
    <form action="/admin/dashboard" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; padding: 1rem 1.25rem;">
      <div class="form-group" style="margin-bottom: 0; min-width: 280px; flex: 1;">
        <label class="form-label" for="dash_tournament">Filtrar por Torneo</label>
        <select id="dash_tournament" name="tournament_id" class="form-select" onchange="this.form.submit()">
          <option value="">-- Todos los torneos --</option>
          <% (tournaments || []).forEach(t => { %>
            <option value="<%= t.id %>" <%= selectedTournamentId == t.id ? 'selected' : '' %>>
              <%= t.name %> (<%= t.datesLabel %>)
            </option>
          <% }) %>
        </select>
      </div>
      <% if (selectedTournamentId) { %>
        <a href="/admin/dashboard" class="btn btn-secondary" style="height: 40px; display: flex; align-items: center;">Ver todos</a>
      <% } %>
    </form>
  </div>

  <!-- Descarga de la planilla de un torneo -->
  <div class="admin-card" style="margin-bottom: 1.5rem;">
    <div class="admin-card-head">
      <div class="head-left">
        <span class="material-symbols-outlined">download</span>
        <h2 class="admin-card-title">Descargar Planilla del Torneo</h2>
      </div>
    </div>
    <form action="/admin/exportar/planilla" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; padding: 1rem 1.25rem;">
      <div class="form-group" style="margin-bottom: 0; min-width: 280px; flex: 1;">
        <label class="form-label" for="planilla_tournament">Torneo</label>
        <select id="planilla_tournament" name="tournament_id" class="form-select" required>
          <option value="">-- Elegí el torneo --</option>
          <% (tournaments || []).forEach(t => { %>
            <option value="<%= t.id %>" <%= selectedTournamentId == t.id ? 'selected' : '' %>>
              <%= t.name %> (<%= t.datesLabel %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="margin-bottom: 0; min-width: 250px;">
        <label class="form-label" for="planilla_agrupar">Agrupar por</label>
        <select id="planilla_agrupar" name="agrupar" class="form-select">
          <option value="libro_mayor" selected>Libro Mayor (orden de salida a pista)</option>
          <option value="disciplina">Disciplina, y adentro por categoría</option>
          <option value="categoria">Categoría (la disciplina va como columna)</option>
          <option value="categoria_hojas">Categoría, cada una en una hoja aparte</option>
        </select>
      </div>
      <button type="submit" class="btn btn-gold" style="height: 40px;">⬇️ Descargar Excel</button>
      <p style="color: var(--text-muted); font-size: 0.85rem; width: 100%; margin: 0.25rem 0 0;">
        El <strong>Libro Mayor</strong> es la planilla de pista: un bloque por disciplina,
        categoría y categoría de edad, con Apellido, Nombre, Edad, Institución y salida a pista,
        más columnas en blanco para el horario y para anotar a mano. Las otras tres arman cuadros
        con nombre completo, edad, disciplina, categoría, categoría de edad y club; la última abre
        una solapa por categoría. En todas, las patinadoras van ordenadas por edad de menor a
        mayor. No incluye las inscripciones canceladas.
      </p>
    </form>
  </div>

  <!-- Summary Stat Tiles -->
  <div class="admin-stat-grid">
    <div class="admin-stat">
      <div class="admin-stat-icon"><span class="material-symbols-outlined">roller_skating</span></div>
      <div>
        <div class="admin-stat-val"><%= stats.totalSkaters %></div>
        <div class="admin-stat-label"><%= selectedTournament ? 'Patinadoras en este Torneo' : 'Total Patinadoras Cargadas' %></div>
      </div>
    </div>

    <div class="admin-stat">
      <div class="admin-stat-icon"><span class="material-symbols-outlined">assignment</span></div>
      <div>
        <div class="admin-stat-val"><%= stats.totalRegistrations %></div>
        <div class="admin-stat-label"><%= selectedTournament ? 'Inscripciones del Torneo' : 'Inscripciones Totales' %></div>
      </div>
    </div>
  </div>

  <!-- Secondary Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Patinadoras por Club -->
    <div class="admin-card" style="margin: 0; display: flex; flex-direction: column;">
      <div class="admin-card-head">
        <div class="head-left">
          <span class="material-symbols-outlined">account_balance</span>
          <h3 class="admin-card-title">Patinadoras por Club</h3>
        </div>
      </div>
      <div style="flex: 1;">
        <% if (registrationsByClub && registrationsByClub.length > 0) { %>
          <% registrationsByClub.forEach(c => { %>
            <div class="admin-list-row">
              <span style="font-weight: 600; text-transform: uppercase; color: var(--text-main);"><%= c.club_name %></span>
              <span class="count-chip"><%= c.count %> inscripciones</span>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color: var(--text-muted); padding: 1.5rem; text-align: center;">Sin datos registrados aún.</p>
        <% } %>
      </div>
    </div>

    <!-- Inscripciones por Disciplina -->
    <div class="admin-card" style="margin: 0; display: flex; flex-direction: column;">
      <div class="admin-card-head">
        <div class="head-left">
          <span class="material-symbols-outlined">category</span>
          <h3 class="admin-card-title">Inscripciones por Disciplina</h3>
        </div>
      </div>
      <div style="flex: 1;">
        <% if (registrationsByDiscipline && registrationsByDiscipline.length > 0) { %>
          <% registrationsByDiscipline.forEach(d => { %>
            <div class="admin-list-row">
              <span style="font-weight: 600; text-transform: uppercase; color: var(--text-main);"><%= d.discipline %></span>
              <span class="count-chip"><%= d.count %> inscripciones</span>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color: var(--text-muted); padding: 1.5rem; text-align: center;">Sin datos registrados aún.</p>
        <% } %>
      </div>
    </div>

    <!-- Últimas Inscripciones Activas -->
    <div class="admin-card" style="margin: 0; display: flex; flex-direction: column;">
      <div class="admin-card-head">
        <div class="head-left">
          <span class="material-symbols-outlined">bolt</span>
          <h3 class="admin-card-title">Últimas Inscripciones Activas</h3>
        </div>
      </div>
      <% if (recentRegistrations && recentRegistrations.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Club</th>
              </tr>
            </thead>
            <tbody>
              <% recentRegistrations.forEach(r => { %>
                <tr>
                  <td><strong><%= r.first_name %></strong></td>
                  <td><strong><%= r.last_name %></strong></td>
                  <td><%= r.club_name %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted); padding: 1.5rem; text-align: center;">Sin inscripciones recientes.</p>
      <% } %>
    </div>
  </div>

  <!-- Master Skaters Table in Status Module -->
  <div class="admin-card">
    <div class="admin-card-head">
      <div class="head-left">
        <span class="material-symbols-outlined">group</span>
        <h2 class="admin-card-title">
          <%= selectedTournament ? 'Patinadoras Inscriptas en ' + selectedTournament.name : 'Datos de Patinadoras Cargadas en el Sistema' %>
          (<%= studentsList.length %>)
        </h2>
      </div>
      <a href="/admin/alumnos/nuevo" class="btn btn-gold btn-sm">+ Nueva Patinadora</a>
    </div>

    <% if (studentsList && studentsList.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>DNI</th>
              <th>CUIL</th>
              <th>Fecha Nacimiento</th>
              <th>Edad</th>
              <th>Club Afiliado</th>
              <th>Profesora a Cargo</th>
              <th>Obra Social / Seguro</th>
              <th>N° Póliza</th>
              <th>Inscripciones</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% studentsList.forEach(s => { %>
              <tr>
                <td><strong><%= s.first_name %></strong></td>
                <td><strong><%= s.last_name %></strong></td>
                <td><strong style="color: var(--gold-light);"><%= s.dni %></strong></td>
                <td><%= s.cuil || '-' %></td>
                <td><%= s.birth_date %></td>
                <td><span class="badge badge-violet"><%= s.age %> AÑOS</span></td>
                <td><strong><%= s.club_name %></strong></td>
                <td><span style="color: var(--gold-primary); font-size: 0.88rem;"><%= s.teacher_name %></span></td>
                <td><%= s.health_insurance %></td>
                <td><%= s.policy_number %></td>
                <td><span class="badge badge-paid"><%= s.reg_count %> torneos</span></td>
                <td>
                  <div style="display: flex; gap: 0.4rem;">
                    <a href="/admin/alumnos/<%= s.id %>/editar" class="btn btn-gold btn-sm">✏️ Editar</a>
                    <a href="/admin/alumnos/<%= s.id %>/documentos" class="btn btn-outline-gold btn-sm">📄 Docs (<%= s.doc_count %>)</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div style="padding: 1rem; border-top: 1px solid rgba(77, 70, 53, 0.1); display: flex; justify-content: center;">
        <a href="/admin/alumnos" class="btn btn-ghost btn-sm" style="text-transform: uppercase; letter-spacing: 0.06em;">
          Ver Todos (<%= studentsList.length %>) <span class="material-symbols-outlined" style="font-size: 1rem; margin-left: 0.25rem;">expand_more</span>
        </a>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2.5rem;">No hay patinadoras registradas en el sistema aún.</p>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
