<%- include('../partials/header', { title: 'Gestión de Torneos' }) %>
<%- include('admin_shell', { activeNav: 'torneos', topbarSection: 'Torneos' }) %>

  <div class="page-head-row">
    <div class="page-head">
      <h1 class="page-title">Gestión de Torneos de la Liga</h1>
      <% if (typeof adminScope !== 'undefined' && adminScope) { %>
        <p class="page-sub">Estás viendo solo los torneos de <strong style="color: var(--gold-light);"><%= adminScope %></strong>, que son los que podés administrar.</p>
      <% } else { %>
        <p class="page-sub">Armado de competencias, fechas y configuración de disciplinas, categorías y categorías de edad.</p>
      <% } %>
    </div>
    <div class="page-head-actions">
      <a href="/admin/torneos/nuevo" class="btn btn-gold">
        <span class="material-symbols-outlined" style="font-size: 1.1rem;">add</span> Crear Nuevo Torneo
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <div class="admin-card">
    <div class="admin-card-head">
      <div class="head-left">
        <span class="material-symbols-outlined">emoji_events</span>
        <h2 class="admin-card-title">Torneos Registrados</h2>
      </div>
    </div>

    <% if (tournaments && tournaments.length > 0) { %>
      <div class="table-responsive">
        <table class="table" style="min-width: 900px;">
          <thead>
            <tr>
              <th>Nombre del Torneo</th>
              <th>Sede</th>
              <th>Fecha Evento</th>
              <th>Cierre Inscripción</th>
              <th>Categorías</th>
              <th>Inscriptos</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% tournaments.forEach(t => { %>
              <tr>
                <td><strong><%= t.name %></strong></td>
                <td>
                  <div style="display: flex; align-items: flex-start; gap: 0.4rem;">
                    <span class="material-symbols-outlined" style="font-size: 1rem; color: #ffb4ab; margin-top: 0.15rem;">location_on</span>
                    <span style="color: var(--text-muted);"><%= t.venue %></span>
                  </div>
                </td>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-muted);">
                    <span class="material-symbols-outlined" style="font-size: 1rem; color: #dbc5ff;">calendar_month</span>
                    <%= t.datesLabel %>
                  </div>
                </td>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-muted);">
                    <span class="material-symbols-outlined" style="font-size: 1rem; color: var(--gold-light);">hourglass_empty</span>
                    <%= t.deadlineLabel || t.registration_deadline %>
                  </div>
                </td>
                <td style="text-align: center;">
                  <span class="cat-chip"><strong><%= t.category_count %></strong><span>Categorías</span></span>
                </td>
                <td style="text-align: center;">
                  <strong><%= t.reg_count %></strong> <span style="color: var(--text-muted);">patinadores</span>
                </td>
                <td style="text-align: center;">
                  <form action="/admin/torneos/<%= t.id %>/estado" method="POST" style="display: flex; align-items: center; gap: 0.4rem; justify-content: center; margin: 0;">
                    <select name="status" class="form-select" style="width: auto; padding: 0.3rem 0.5rem; font-size: 0.8rem;">
                      <option value="upcoming" <%= t.status === 'upcoming' ? 'selected' : '' %>>PRÓXIMO</option>
                      <option value="active" <%= t.status === 'active' ? 'selected' : '' %>>ACTIVO</option>
                      <option value="finished" <%= t.status === 'finished' ? 'selected' : '' %>>FINALIZADO</option>
                    </select>
                    <button type="submit" class="btn btn-ghost btn-sm" title="Guardar estado">
                      <span class="material-symbols-outlined" style="font-size: 1rem;">save</span>
                    </button>
                  </form>
                </td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 0.4rem; justify-content: flex-end; flex-wrap: wrap;">
                    <a href="/admin/torneos/<%= t.id %>/editar" class="btn btn-gold btn-sm">
                      <span class="material-symbols-outlined" style="font-size: 1rem; margin-right: 0.3rem;">edit</span>
                      Editar Torneo
                    </a>
                    <a href="/admin/torneos/<%= t.id %>/categorias" class="btn btn-outline-gold btn-sm">
                      <span class="material-symbols-outlined" style="font-size: 1rem; margin-right: 0.3rem;">settings</span>
                      Disciplinas y Categorías
                    </a>
                    <form action="/admin/torneos/<%= t.id %>/eliminar" method="POST" style="margin: 0;">
                      <button type="submit" class="btn btn-danger btn-sm"
                        onclick="return confirm('¿Eliminar el torneo <%= t.name %>?\nSolo se puede si no tiene inscripciones.');"
                        <%= Number(t.reg_count) > 0 ? 'disabled title="Tiene inscripciones cargadas"' : '' %>>
                        🗑️
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No hay torneos creados aún.</p>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
