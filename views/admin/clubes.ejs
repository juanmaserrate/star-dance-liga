<%- include('../partials/header', { title: 'Clubes Afiliados' }) %>
<%- include('admin_shell', { activeNav: 'clubes', topbarSection: 'Clubes' }) %>

  <div class="page-head-row">
    <div class="page-head">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="material-symbols-outlined" style="font-size: 2.4rem; color: var(--gold-light); font-variation-settings: 'FILL' 1;">account_balance</span>
        <h1 class="page-title" style="margin-bottom: 0;">Clubes e Instituciones Afiliadas</h1>
      </div>
      <p class="page-sub" style="margin-top: 0.5rem;">Padrón oficial de clubes participantes de la Liga Star Dance.</p>
    </div>
    <div class="page-head-actions">
      <button type="button" class="btn btn-gold" onclick="toggleNewClubForm()" style="display: flex; align-items: center; gap: 0.5rem;">
        <span class="material-symbols-outlined" id="toggleBtnIcon" style="font-size: 1.1rem;">add</span>
        <span id="toggleBtnText">Nuevo Club</span>
      </button>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-auto-dismiss">✅ <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-auto-dismiss">⚠️ <%= error %></div>
  <% } %>

  <!-- Alta de club: oculta hasta que se toca el botón. Si el alta falló, se
       abre sola para que no haya que volver a buscarla. -->
  <div class="card" id="newClubFormCard"
       style="display: <%= (typeof error !== 'undefined' && error) ? 'block' : 'none' %>; max-width: 600px; margin: 0 auto 2rem auto; border: 1px solid var(--gold-primary); box-shadow: 0 0 20px rgba(212,175,55,0.15); animation: slideDown 0.3s ease-out;">
    <div class="card-header" style="border-bottom: 1px solid rgba(212,175,55,0.2); padding-bottom: 0.75rem;">
      <h2 class="card-title" style="font-size: 1.2rem; color: var(--gold-light);">🏛️ Registrar Nuevo Club</h2>
    </div>

    <form action="/admin/clubes" method="POST" style="margin-top: 1rem;">
      <div class="form-group">
        <label class="form-label" for="name">Nombre del Club / Escuela *</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="EJ: CLUB DEPORTIVO ESTRELLA" required style="text-transform: uppercase;">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="city">Ciudad / Provincia</label>
          <input type="text" id="city" name="city" class="form-control" placeholder="EJ: LOMAS DE ZAMORA">
        </div>

        <div class="form-group">
          <label class="form-label" for="representative">Representante / Delegado</label>
          <input type="text" id="representative" name="representative" class="form-control" placeholder="Nombre del responsable">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="contact_phone">Teléfono de Contacto</label>
        <input type="text" id="contact_phone" name="contact_phone" class="form-control" placeholder="EJ: +54 9 11 ...">
      </div>

      <div style="display: flex; gap: 0.6rem; margin-top: 1.25rem; flex-wrap: wrap;">
        <button type="submit" class="btn btn-gold">✨ Registrar Club</button>
        <button type="button" class="btn btn-secondary" onclick="toggleNewClubForm()">Cancelar</button>
      </div>
    </form>
  </div>

  <!-- Listado de clubes: ocupa todo el ancho de la pantalla -->
  <div class="admin-card">
    <div class="admin-card-head">
      <div class="head-left">
        <span class="material-symbols-outlined">list</span>
        <h2 class="admin-card-title">Clubes Inscriptos</h2>
      </div>
      <span class="count-chip"><%= clubs.length %> <%= clubs.length === 1 ? 'club' : 'clubes' %></span>
    </div>

    <% if (clubs && clubs.length > 0) { %>
      <!-- Buscador y filtros. Trabajan sobre las filas ya cargadas. -->
      <div id="clubFiltros" style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-gold);">
        <div style="position: relative; margin-bottom: 0.75rem;">
          <span style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--gold-light); font-size: 1.1rem;">&#128269;</span>
          <input type="search" id="cBuscar" class="form-control" style="padding-left: 2.4rem;"
                 placeholder="Buscar club, ciudad, representante o tel&eacute;fono&hellip;" autocomplete="off">
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.6rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="cCiudad">Ciudad</label>
            <select id="cCiudad" class="form-select" data-campo="ciudad"></select>
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="cActividad">Actividad</label>
            <select id="cActividad" class="form-select" data-campo="actividad"></select>
          </div>
          <div class="form-group" style="margin-bottom: 0; display: flex; align-items: flex-end;">
            <button type="button" id="cLimpiar" class="btn btn-secondary btn-sm" style="width: 100%; height: 40px;">Limpiar filtros</button>
          </div>
        </div>
        <div style="margin-top: 0.75rem;">
          <span id="cContador" class="count-chip"></span>
          <span id="cSinResultados" style="display: none; color: var(--gold-light); font-size: 0.88rem; margin-left: 0.5rem;">
            Ning&uacute;n club coincide con lo que buscás.
          </span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Club</th>
              <th>Ciudad</th>
              <th>Representante</th>
              <th>Teléfono</th>
              <th>Profesores</th>
              <th>Alumnas</th>
              <th>Ficha</th>
            </tr>
          </thead>
          <tbody>
            <% clubs.forEach(c => { %>
              <%
                // "Actividad" separa los clubes que ya estan participando de los
                // que figuran en el padron pero todavia no cargaron a nadie.
                const actividad = Number(c.student_count) > 0 ? 'Con patinadoras' : 'Sin patinadoras';
                const buscable = [c.name, c.city, c.representative, c.contact_phone]
                  .filter(Boolean).join(' ').toLowerCase();
              %>
              <tr data-ciudad="<%= c.city || '' %>"
                  data-actividad="<%= actividad %>"
                  data-buscar="<%= buscable %>">
                <td><strong><%= c.name %></strong></td>
                <td><%= c.city || 'No especificada' %></td>
                <td><%= c.representative || '-' %></td>
                <td><span style="color: var(--gold-primary);"><%= c.contact_phone || '-' %></span></td>
                <td><span class="badge badge-violet"><%= c.teacher_count %> profes</span></td>
                <td><strong><%= c.student_count %> atletas</strong></td>
                <td>
                  <a href="/admin/clubes/<%= c.id %>" class="btn btn-outline-gold btn-sm" title="Ver profesoras, alumnas e inscripciones">Ver ficha</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">
        Todavía no hay clubes registrados.<br>
        Tocá <strong>Nuevo Club</strong> arriba para cargar el primero.
      </p>
    <% } %>
  </div>

</main>

<script>
  // --- Buscador y filtros del listado de clubes ---
  (function () {
    const barra = document.getElementById('clubFiltros');
    const tabla = document.querySelector('.admin-card tbody');
    if (!barra || !tabla) return;

    const filas = Array.from(tabla.querySelectorAll('tr'));
    const selects = Array.from(barra.querySelectorAll('select[data-campo]'));
    const buscador = document.getElementById('cBuscar');
    const contador = document.getElementById('cContador');
    const vacio = document.getElementById('cSinResultados');

    function pasa(fila, exceptuar) {
      const texto = (buscador.value || '').trim().toLowerCase();
      if (texto && !(fila.dataset.buscar || '').includes(texto)) return false;
      return selects.every(function (sel) {
        const campo = sel.dataset.campo;
        if (campo === exceptuar || !sel.value) return true;
        return (fila.dataset[campo] || '') === sel.value;
      });
    }

    // Cada desplegable ofrece solo lo que sigue siendo posible con los otros
    function poblar() {
      selects.forEach(function (sel) {
        const campo = sel.dataset.campo;
        const elegido = sel.value;
        const posibles = [...new Set(
          filas.filter(function (f) { return pasa(f, campo); })
               .map(function (f) { return f.dataset[campo] || ''; })
               .filter(Boolean)
        )].sort(function (a, b) { return a.localeCompare(b, 'es'); });
        if (elegido && posibles.indexOf(elegido) === -1) posibles.unshift(elegido);

        sel.innerHTML = '';
        const todas = document.createElement('option');
        todas.value = '';
        todas.textContent = 'Todas / todos';
        sel.appendChild(todas);
        posibles.forEach(function (v) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = v;
          sel.appendChild(opt);
        });
        sel.value = elegido;
      });
    }

    function aplicar() {
      let visibles = 0;
      filas.forEach(function (f) {
        const ok = pasa(f, null);
        f.style.display = ok ? '' : 'none';
        if (ok) visibles++;
      });
      contador.textContent = visibles === filas.length
        ? filas.length + (filas.length === 1 ? ' club' : ' clubes')
        : 'Mostrando ' + visibles + ' de ' + filas.length;
      vacio.style.display = visibles === 0 ? 'inline' : 'none';
      poblar();
    }

    selects.forEach(function (sel) { sel.addEventListener('change', aplicar); });
    buscador.addEventListener('input', aplicar);
    document.getElementById('cLimpiar').addEventListener('click', function () {
      buscador.value = '';
      selects.forEach(function (sel) { sel.value = ''; });
      aplicar();
    });

    aplicar();
  })();

  function toggleNewClubForm() {
    const card = document.getElementById('newClubFormCard');
    const icon = document.getElementById('toggleBtnIcon');
    const text = document.getElementById('toggleBtnText');

    if (card.style.display === 'none') {
      card.style.display = 'block';
      if (icon) icon.innerText = 'close';
      text.innerText = 'Cerrar Formulario';
      document.getElementById('name').focus();
    } else {
      card.style.display = 'none';
      if (icon) icon.innerText = 'add';
      text.innerText = 'Nuevo Club';
    }
  }

  // Si el formulario quedó abierto por un error, el botón tiene que decirlo.
  document.addEventListener('DOMContentLoaded', () => {
    const card = document.getElementById('newClubFormCard');
    if (card && card.style.display === 'block') {
      const icon = document.getElementById('toggleBtnIcon');
      if (icon) icon.innerText = 'close';
      document.getElementById('toggleBtnText').innerText = 'Cerrar Formulario';
    }
  });
</script>

<style>
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<%- include('../partials/footer') %>
