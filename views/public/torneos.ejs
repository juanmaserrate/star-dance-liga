<%- include('../partials/header', { title: 'Torneos' }) %>
<%- include('../partials/navbar') %>

<div class="main-wrapper">
  <div class="card">
    <div class="card-header">
      <h1 class="card-title">🏆 Torneos de la Liga Star Dance</h1>
    </div>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      Calendario oficial de competencias, torneos provinciales e interclubes de patinaje artístico.
    </p>

    <% if (tournaments && tournaments.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <% tournaments.forEach(t => { %>
          <div class="card" style="background: rgba(30, 10, 46, 0.7); margin: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem;">
              <span class="badge badge-violet"><%= t.status === 'upcoming' ? 'PRÓXIMO' : (t.status === 'active' ? 'EN CURSO' : 'FINALIZADO') %></span>
              <span style="color: var(--gold-light); font-size: 0.85rem; font-weight: 700;">Inscriptos: <%= t.total_registered %></span>
            </div>
            <h2 style="color: var(--gold-primary); font-size: 1.35rem; margin-bottom: 0.6rem;"><%= t.name %></h2>
            <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1rem;">
              <%= t.description %>
            </p>
            <div style="background: rgba(18, 6, 28, 0.6); padding: 0.85rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-size: 0.88rem; border-left: 3px solid var(--gold-primary);">
              📍 <strong>Lugar/Sede:</strong> <%= t.venue %><br>
              📅 <strong>Fecha del Evento:</strong> <%= t.event_date %><br>
              ⏳ <strong>Cierre de Inscripción:</strong> <%= t.registration_deadline %><br>
              📊 <strong>Categorías:</strong> <%= t.total_categories %> niveles
            </div>
            <a href="/torneos/<%= t.id %>" class="btn btn-gold" style="width: 100%;">Ver Categorías e Inscribir</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No hay torneos registrados actualmente.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
